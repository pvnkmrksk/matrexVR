      }
    },
    {
      "title": "Downloaded skeletal GLB",
      "sceneName": "Choice",
      "duration": 8,
      "reloadScene": true,
      "parameters": {
        "configFile": "Examples/Models/rigged-glb.example.json"
      }
    },
    {
      "title": "Downloaded morph-animation GLB",
      "sceneName": "Choice",
      "duration": 8,
      "reloadScene": true,
      "parameters": {
        "configFile": "Examples/Models/morph-glb.example.json"
      }
    }
  ]
}
