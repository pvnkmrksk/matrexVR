/* Experiment control: one navigation rail, a shared workspace, compact property groups. */
.workbench { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(24, 27, 32); color: rgb(223, 228, 234); font-size: 13px; }
.row { flex-direction: row; align-items: center; min-height: 32px; }
.header, .footer { flex-shrink: 0; background-color: rgb(29, 33, 39); }
.header { height: 64px; padding: 0 22px; border-bottom-width: 1px; border-bottom-color: rgb(51, 56, 64); }
.identity { width: 204px; flex-shrink: 0; }
.brand { font-size: 19px; -unity-font-style: bold; letter-spacing: 1px; }
.brand-detail { color: rgb(126, 137, 150); font-size: 9px; letter-spacing: 1px; margin-top: 3px; }
.page-location { flex-grow: 1; flex-basis: 0; color: rgb(167, 178, 191); font-size: 12px; margin-left: 24px; overflow: hidden; text-overflow: ellipsis; }
.badge { color: rgb(131, 194, 168); font-size: 10px; padding: 5px 10px; margin-right: 18px; }
.frame-rate { color: rgb(191, 204, 218); font-size: 12px; min-width: 158px; -unity-text-align: middle-right; }
.main { flex-grow: 1; min-height: 0; align-items: stretch; }
.sidebar { width: 224px; flex-shrink: 0; padding: 20px 12px; background-color: rgb(27, 30, 36); border-right-width: 1px; border-right-color: rgb(48, 53, 61); }
.sidebar .nav-heading { color: rgb(117, 132, 148); font-size: 9px; letter-spacing: 1px; margin: 22px 12px 9px; }
.sidebar #navigation-title { margin-top: 0; }
.sidebar .studio-button { min-height: 40px; height: auto; justify-content: flex-start; margin: 2px 0; padding: 8px 11px; border-width: 0; background-color: rgba(0,0,0,0); }
.sidebar .studio-button Label { flex-grow: 1; flex-basis: 0; white-space: normal; -unity-text-align: middle-left; font-size: 13px; }
.sidebar .studio-button:hover { background-color: rgb(39, 45, 54); }
.sidebar Button.nav-active { background-color: rgb(44, 61, 79); color: rgb(187, 218, 246); border-left-width: 3px; border-left-color: rgb(113, 172, 225); padding-left: 8px; }
.sidebar .nav-file { padding-left: 17px; }
.sidebar .nav-file Label { font-size: 11px; color: rgb(157, 169, 183); }
.sidebar Button.file-active { background-color: rgb(37, 45, 56); }
.sidebar Button.file-active Label { color: rgb(180, 211, 239); }
.body { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; padding: 26px 28px 18px; }
.title { font-size: 26px; -unity-font-style: bold; margin-bottom: 5px; white-space: normal; }
.location, .studio-subtitle { color: rgb(141, 155, 171); font-size: 11px; white-space: normal; margin-bottom: 20px; }
.studio-title-row { align-items: flex-start; }
.studio-title-row > .studio-button { margin-top: 0; }
.studio-icon { width: 20px; height: 20px; flex-shrink: 0; margin-right: 8px; color: rgb(141, 167, 194); }
.studio-button { flex-direction: row; align-items: center; justify-content: center; }
.studio-button Label { white-space: nowrap; }
Button { background-color: rgb(44, 50, 59); color: rgb(218, 226, 235); border-width: 1px; border-color: rgb(65, 74, 85); border-radius: 4px; padding: 6px 10px; margin: 3px; height: 32px; font-size: 12px; }
Button:hover { background-color: rgb(56, 66, 79); border-color: rgb(127, 169, 208); }
Button:focus { border-color: rgb(136, 182, 224); }
Button.primary { background-color: rgb(156, 196, 230); border-color: rgb(156, 196, 230); color: rgb(23, 42, 58); -unity-font-style: bold; }
.primary .studio-icon { color: rgb(37, 70, 96); }
Button.quiet { background-color: rgb(35, 40, 47); }
Button.icon-button { width: 28px; height: 28px; padding: 4px; margin: 0 2px; border-width: 0; background-color: rgba(0,0,0,0); }
.icon-button .studio-icon { margin-right: 0; width: 18px; height: 18px; }
Button.tab-active { background-color: rgb(42, 59, 77); color: rgb(196, 220, 243); border-color: rgb(97, 135, 171); }
.pill { font-size: 10px; border-radius: 3px; padding: 4px 7px; margin-right: 7px; white-space: normal; background-color: rgb(43, 49, 59); color: rgb(171, 187, 205); }
.pill.accent { background-color: rgb(39, 62, 57); color: rgb(157, 204, 181); }
.pill.muted-pill { background-color: rgba(0,0,0,0); color: rgb(126, 143, 159); }
.pill.warm-pill { background-color: rgb(68, 58, 40); color: rgb(218, 194, 147); }
.pill.unit-pill { padding: 1px 4px; margin-left: 4px; margin-right: 2px; font-size: 10px; background-color: rgba(0,0,0,0); color: rgb(133, 151, 169); }
.sequence-stats { margin-bottom: 10px; }
.sequence-flags { flex-wrap: wrap; margin-bottom: 8px; }
.sequence-flag { height: 34px; min-height: 34px; padding: 5px 9px; background-color: rgb(35, 40, 48); border-color: rgb(57, 67, 80); }
.sequence-flag .studio-icon { width: 17px; height: 17px; }
.sequence-flag.is-on { background-color: rgb(37, 54, 55); color: rgb(167, 212, 192); border-color: rgb(66, 100, 89); }
.flag-state { font-size: 9px; margin-left: 9px; color: rgb(124, 142, 160); }
.is-on .flag-state { color: rgb(151, 209, 181); }
.sequence-flags .unity-integer-field { width: 165px; margin-left: 15px; }
.sequence-flags .unity-base-field__label { min-width: 0; width: 108px; font-size: 10px; }
.run-options { margin-bottom: 9px; }
.run-option { flex-grow: 1; padding-right: 12px; }
.run-option > Label { margin-right: 10px; }
.block-list { flex-grow: 1; min-height: 0; margin-top: 8px; }
.block-holder { height: 156px; padding: 0 0 10px; }
.block-card { flex-grow: 1; padding: 13px 16px; border-width: 1px; border-color: rgb(57, 67, 79); border-radius: 6px; background-color: rgb(31, 37, 45); }
.block-card:hover { border-color: rgb(100, 128, 155); }
.unity-collection-view__item--selected .block-card { border-color: rgb(128, 174, 215); background-color: rgb(35, 46, 60); }
.block-heading { min-height: 26px; }
.block-number { font-size: 18px; -unity-font-style: bold; color: rgb(137, 169, 198); margin-right: 12px; }
.block-name { flex-grow: 1; flex-basis: 0; -unity-font-style: bold; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.block-description { color: rgb(166, 180, 196); font-size: 11px; white-space: normal; margin: 9px 0 7px; }
.block-bottom { min-height: 28px; }
.block-bottom Button { height: 28px; font-size: 11px; }
.block-reference { flex-grow: 1; flex-basis: 0; color: rgb(130, 150, 173); font-size: 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.builder-add-row { margin-top: 7px; }
.builder-add-row > Label { flex-grow: 1; flex-basis: 0; font-size: 11px; color: rgb(140, 156, 174); margin-left: 12px; white-space: normal; }
.inspector { width: 268px; flex-shrink: 0; padding: 26px 18px; background-color: rgb(27, 30, 36); border-left-width: 1px; border-left-color: rgb(48, 53, 61); }
.inspector Label { white-space: normal; }
.inspector .unity-scroll-view__content-container > Label { color: rgb(149, 165, 183); font-size: 11px; margin-bottom: 13px; }
.inspector #overview-title { font-size: 9px; letter-spacing: 1px; color: rgb(124, 140, 158); }
.overview-duration { font-size: 26px; color: rgb(224, 231, 239); margin: 3px 0 8px; }
.inspector #selected-block-title { font-size: 16px; color: rgb(220, 229, 238); }
.inspector .pill { margin-bottom: 10px; }
.inspector .studio-setting { width: 100%; max-width: none; min-width: 0; margin: 3px 0; padding: 7px 0; border-width: 0; background-color: rgba(0,0,0,0); }
.inspector .studio-setting > .setting-label { min-width: 60px; }
.inspector .studio-button { margin: 5px 0; }
.inspector .unity-base-field { flex-direction: column; }
.inspector .unity-base-field__label { min-width: 0; margin-bottom: 5px; }
.health-card { padding: 12px 0; margin-top: 18px; border-top-width: 1px; border-top-color: rgb(55, 65, 78); }
.health-card Label { font-size: 11px; color: rgb(149, 168, 186); margin-bottom: 7px; }
.footer { height: 64px; padding: 10px 22px; border-top-width: 1px; border-top-color: rgb(51, 56, 64); }
.footer .status { flex-grow: 1; flex-basis: 0; min-width: 0; color: rgb(146, 162, 180); font-size: 11px; white-space: normal; }
.footer Button { flex-shrink: 0; }
.footer .primary { min-width: 178px; margin-left: 12px; }
.error { color: rgb(241, 149, 137); }
.warning { color: rgb(217, 193, 146); }
.phase-tabs { margin: 2px 0 10px; }
.phase-tabs Button { flex-grow: 1; font-size: 11px; }
.phase-enable { padding: 7px 12px; background-color: rgb(31, 42, 51); border-radius: 4px; margin-bottom: 10px; }
.phase-enable > Label { margin-right: 12px; }
.phase-hint { color: rgb(143, 163, 181); font-size: 11px; margin-left: 15px; }
.settings-tabs { margin-bottom: 14px; padding-bottom: 10px; border-bottom-width: 1px; border-bottom-color: rgb(52, 61, 73); flex-wrap: wrap; }
.settings-tabs Button { padding: 5px 12px; margin: 0 5px 3px 0; }
.settings-scroll { flex-grow: 1; min-height: 0; }
.settings-scroll .unity-scroll-view__content-container { min-width: 0; }
.settings-section { margin: 0 0 22px; }
.section-heading { min-height: 28px; margin-bottom: 8px; }
.section-heading .studio-icon { width: 17px; height: 17px; }
.section-heading > Label { flex-grow: 1; font-size: 13px; -unity-font-style: bold; color: rgb(188, 202, 218); }
.settings-grid { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
.studio-setting { width: 322px; min-height: 48px; padding: 9px 12px; margin: 0 9px 8px 0; background-color: rgb(31, 36, 44); border-width: 1px; border-color: rgb(48, 57, 68); border-radius: 4px; }
.studio-setting:hover { border-color: rgb(79, 102, 126); }
.setting-label { min-height: 20px; margin: 0 0 5px; flex-wrap: wrap; }
.setting-title { font-size: 12px; color: rgb(206, 216, 229); white-space: normal; }
.numeric-setting, .boolean-setting, .color-setting { flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; }
.numeric-setting > .setting-label, .boolean-setting > .setting-label, .color-setting > .setting-label { flex-grow: 1; flex-basis: 130px; margin: 0 8px 0 0; }
.boolean-setting { width: 286px; }
.boolean-setting > .setting-label { flex-basis: 158px; }
.container-setting { width: 100%; margin-right: 0; padding: 12px; background-color: rgb(29, 35, 42); }
.container-setting > .setting-label { margin-right: 12px; }
.container-setting > .setting-label > .setting-title { flex-grow: 1; }
.container-setting > .setting-label > .studio-switch { margin-left: 12px; }
.container-setting > .setting-label > .disclosure-button { margin-left: 16px; font-size: 11px; height: 28px; background-color: rgba(0,0,0,0); border-width: 0; }
.container-setting > .studio-switch { align-self: flex-start; margin-top: 0; margin-bottom: 8px; }
.container-setting > Foldout { margin: 3px 0 0; }
.container-setting > Foldout > .unity-foldout__toggle { display: none; }
.container-setting > Foldout > .unity-foldout__content { flex-direction: row; flex-wrap: wrap; margin-left: 0; padding-top: 8px; }
.container-setting .container-setting { background-color: rgb(27, 33, 40); }
.vector-setting { width: 484px; }
.vector-controls { flex-wrap: wrap; }
.vector-controls > Label { font-size: 10px; color: rgb(146, 174, 199); margin-right: 5px; }
.vector-controls > .number-control { margin-right: 16px; }
.number-control { flex-grow: 0; flex-shrink: 0; min-width: 64px; }
.spin-box { min-height: 28px; flex-shrink: 0; }
.exact-number { margin: 0; flex-grow: 0; flex-shrink: 0; }
.exact-number .unity-base-field__input { -unity-text-align: middle-right; min-height: 28px; padding: 4px 7px; }
.spin-arrows { width: 16px; height: 28px; flex-shrink: 0; margin-left: 2px; }
.spin-arrows Button { width: 16px; height: 14px; min-height: 14px; padding: 0; margin: 0; border-width: 0; font-size: 9px; border-radius: 2px; }
.number-control.with-slider { min-width: 112px; }
.number-control .unity-base-slider { width: 112px; min-height: 12px; margin: 5px 0 0; }
.unity-base-slider__tracker { height: 3px; background-color: rgb(65, 80, 97); border-width: 0; }
.unity-base-slider__dragger, .unity-base-slider__dragger-border { background-image: none; background-color: rgb(150, 187, 219); width: 11px; height: 11px; border-width: 0; border-radius: 7px; }
.color-control { flex-grow: 0; min-height: 28px; }
.color-control .unity-color-field { width: 68px; min-width: 68px; margin: 0; }
.color-hex { font-size: 10px; color: rgb(142, 164, 186); margin-left: 8px; }
.color-preview { height: 56px; border-radius: 4px; margin-bottom: 12px; }
.text-setting, .choice-setting { width: 322px; flex-direction: row; align-items: center; justify-content: space-between; }
.text-setting > .setting-label, .choice-setting > .setting-label { flex-grow: 1; flex-basis: 100px; margin: 0 8px 0 0; }
.text-setting > TextField, .choice-setting > DropdownField { width: 140px; flex-shrink: 0; margin: 0; }
.backend-setting { flex-direction: column; align-items: stretch; }
.backend-setting > .setting-label { flex-grow: 0; flex-basis: auto; margin: 0 0 5px; }
.backend-setting > DropdownField { width: auto; min-width: 0; }
.path-setting { width: 650px; }
.path-setting > TextField { width: 440px; }
.feature-grid { flex-wrap: wrap; }
.feature-card { width: 244px; padding: 12px; margin: 0 10px 10px 0; border-width: 1px; border-color: rgb(56, 68, 82); border-radius: 4px; background-color: rgb(31, 39, 48); }
.feature-card .row > Label { flex-grow: 1; font-size: 12px; -unity-font-style: bold; }
.feature-card > .pill { margin-top: 7px; margin-bottom: 7px; }
.feature-card Button { margin: 0; }
.studio-switch { min-height: 22px; margin: 0; flex-shrink: 0; }
.studio-switch .unity-toggle__checkmark { display: none; }
.studio-switch .unity-toggle__input { background-color: rgba(0,0,0,0); padding: 0; border-width: 0; flex-direction: row; align-items: center; }
.switch-track { width: 32px; height: 18px; border-radius: 10px; background-color: rgb(54, 63, 76); border-width: 1px; border-color: rgb(81, 95, 111); }
.switch-knob { position: absolute; left: 3px; top: 3px; width: 10px; height: 10px; border-radius: 7px; background-color: rgb(151, 166, 183); }
.is-on .switch-track { background-color: rgb(56, 97, 88); border-color: rgb(91, 147, 122); }
.is-on .switch-knob { left: 18px; background-color: rgb(174, 220, 193); }
.switch-indicator { font-size: 9px; color: rgb(146, 163, 181); margin-left: 7px; min-width: 22px; }
.is-on .switch-indicator { color: rgb(160, 208, 184); }
.rig-card { margin: 6px 0 10px; padding: 12px; border-width: 1px; border-color: rgb(53, 63, 77); border-radius: 5px; background-color: rgb(29, 35, 43); }
.rig-card > .unity-foldout__toggle { -unity-font-style: bold; margin-bottom: 9px; }
.unity-base-field { color: rgb(219, 228, 239); margin: 4px; min-width: 0; }
.unity-base-field__input { background-color: rgb(22, 27, 34); color: rgb(227, 235, 244); border-width: 1px; border-color: rgb(65, 78, 94); border-radius: 3px; min-height: 27px; padding: 4px 7px; }
.unity-base-field__input:focus { border-color: rgb(137, 181, 222); }
.unity-base-field__label { color: rgb(162, 181, 201); }
.unity-base-popup-field__text { color: rgb(220, 231, 242); }
.unity-scroll-view__vertical-scroller { width: 8px; }
.unity-scroll-view__horizontal-scroller { display: none; }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }
.unity-scroller .unity-base-slider__tracker { width: 5px; background-image: none; background-color: rgb(30, 36, 44); }
.unity-scroller .unity-base-slider__dragger, .unity-scroller .unity-base-slider__dragger-border { width: 5px; background-image: none; background-color: rgb(75, 94, 113); border-width: 0; }
.session-scroll { flex-grow: 1; min-height: 0; }
.session-welcome { align-items: flex-start; margin-bottom: 10px; }
.session-hint { color: rgb(143, 159, 178); font-size: 11px; white-space: normal; }
.session-details { align-items: flex-start; height: 82px; min-height: 82px; padding: 10px 14px; margin-bottom: 10px; border-width: 1px; border-color: rgb(53, 62, 73); border-radius: 5px; background-color: rgb(30, 36, 44); }
.session-field { flex-grow: 0; min-width: 0; flex-direction: column; align-items: stretch; margin: 0 12px 9px 0; }
.session-details > .session-field { flex-grow: 1; flex-basis: 0; }
.session-details > .session-comments { flex-grow: 1.3; }
.session-field > .unity-base-field__label, .subject-traits > .unity-base-field > .unity-base-field__label { min-width: 0; font-size: 11px; margin-bottom: 5px; height: 16px; }
.session-field .unity-text-field__input, .subject-traits .unity-base-popup-field__input { min-height: 32px; padding: 6px 8px; }
.session-comments .unity-text-field__input { min-height: 42px; white-space: normal; }
.session-section-heading { margin: 5px 0 9px; }
.session-section-title { -unity-font-style: bold; font-size: 15px; margin-right: 16px; }
.session-section-heading > .session-hint { flex-grow: 1; flex-basis: 0; }
.subject-grid { flex-wrap: wrap; align-items: flex-start; }
.subject-card { flex-grow: 1; flex-basis: 22%; min-width: 230px; margin: 0 10px 12px 0; padding: 12px; border-width: 1px; border-color: rgb(57, 68, 82); border-radius: 5px; background-color: rgb(31, 38, 47); }
.subject-heading { min-height: 28px; margin-bottom: 8px; }
.subject-heading > .pill { flex-shrink: 0; white-space: nowrap; }
.subject-name { flex-grow: 1; font-size: 16px; -unity-font-style: bold; }
.subject-card > .session-field { margin: 0 0 5px; height: 58px; }
.subject-card > .session-comments { height: 72px; margin-bottom: 0; }
.subject-traits { align-items: flex-start; height: 58px; margin-bottom: 8px; }
.subject-traits > .unity-base-field { flex-direction: column; align-items: stretch; height: 58px; min-height: 58px; min-width: 0; flex-basis: 0; flex-grow: 1; margin: 0 10px 0 0; }
.subject-traits > .session-field { margin-right: 0; }
.subject-traits > .unity-base-popup-field { flex-grow: 1.35; }
.subject-traits .unity-base-popup-field__text { font-size: 11px; }
.session-system { height: auto; min-height: 64px; padding: 10px 15px; margin: 0 0 13px; background-color: rgb(30, 42, 51); border-color: rgb(55, 79, 100); justify-content: flex-start; }
.session-system > #session-system-headline { flex-grow: 1; flex-basis: 0; margin: 0 12px; color: rgb(174, 194, 213); font-size: 11px; white-space: normal; -unity-text-align: middle-left; }
.session-system > Label { font-size: 11px; color: rgb(166, 200, 229); }
.session-plan { flex-shrink: 0; margin-bottom: 9px; }
.session-plan-holder { height: 50px; padding-bottom: 5px; }
.session-plan-row { height: 45px; padding: 5px 12px; border-radius: 4px; background-color: rgb(32, 39, 49); }
.session-plan-title { font-size: 12px; -unity-font-style: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.session-plan-description { font-size: 10px; color: rgb(143, 166, 188); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.experiment-link { min-height: 74px; height: auto; justify-content: flex-start; padding: 14px 18px; margin: 0 0 10px; }
.experiment-link > .studio-icon { margin-right: 15px; }
.timing-warning { padding: 8px 11px; margin-bottom: 12px; min-height: 36px; border-left-width: 2px; border-left-color: rgb(188, 151, 87); border-radius: 3px; background-color: rgb(53, 46, 35); }
.timing-warning > Label { flex-grow: 1; flex-basis: 0; color: rgb(217, 195, 150); font-size: 11px; white-space: normal; }
.timing-warning .studio-icon { width: 17px; height: 17px; color: rgb(217, 195, 150); }
.hover-help { position: absolute; padding: 14px 16px; max-height: 244px; border-width: 1px; border-color: rgb(104, 131, 156); border-radius: 5px; background-color: rgb(40, 50, 63); }
.hover-help Label { white-space: normal; font-size: 12px; color: rgb(226, 236, 247); }
.modal-shade { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(7, 12, 19, 0.87); }
.studio-dialog { width: 1000px; max-width: 95%; height: 700px; max-height: 90%; padding: 25px; background-color: rgb(28, 35, 44); border-width: 1px; border-color: rgb(97, 127, 156); border-radius: 6px; }
.studio-dialog > Label { color: rgb(156, 180, 202); font-size: 12px; margin: 6px 0 15px; white-space: normal; }
.small-dialog { width: 530px; height: auto; min-height: 230px; max-height: 80%; }
.small-dialog > .unity-base-field { margin-bottom: 12px; }
.small-dialog TextField { max-width: 470px; }
.library-layout { flex-grow: 1; align-items: stretch; padding: 10px 0; }
.preset-list { flex-grow: 1; flex-basis: 0; }
.preset-card { height: 82px; padding: 10px; border-bottom-width: 1px; border-bottom-color: rgb(57, 69, 82); }
.preset-name { flex-grow: 1; }
.preset-card .key-hint { margin-left: 28px; }
.library-preview { width: 300px; margin-left: 16px; padding: 14px 18px; background-color: rgb(37, 48, 62); border-radius: 4px; }
.library-preview Label { margin-bottom: 16px; white-space: normal; }
.library-preview #preset-title { font-size: 20px; -unity-font-style: bold; color: rgb(224, 236, 247); }
.library-preview .unity-base-field { flex-direction: column; }
.breadcrumb { font-size: 12px; color: rgb(164, 199, 230); margin: 14px 0 8px; }
.search { flex-grow: 1; min-width: 80px; }
.fields { flex-grow: 1; margin: 12px 0; background-color: rgb(29, 36, 45); border-radius: 4px; }
.field-row { height: 64px; flex-direction: row; align-items: center; padding: 7px 12px; border-bottom-width: 1px; border-bottom-color: rgb(49, 60, 73); }
.caption { width: 40%; }
.caption > Label { white-space: normal; }
.key-hint { font-size: 10px; color: rgb(141, 162, 184); margin-top: 4px; }
.field-controls { flex-grow: 1; flex-basis: 0; flex-direction: row; align-items: center; }
.field-controls TextField, .field-controls DropdownField { flex-grow: 1; flex-basis: 0; min-width: 45px; }
Button.mini { height: 29px; padding: 3px 6px; font-size: 11px; }
.raw-json { flex-grow: 1; flex-basis: 0; flex-shrink: 1; min-height: 0; margin-top: 16px; }
.raw-json .unity-text-field__input { min-height: 0; white-space: normal; -unity-text-align: upper-left; }
.json-actions { flex-shrink: 0; min-height: 38px; margin-top: 8px; }
.metadata { flex-grow: 1; padding-top: 15px; }
.metadata Label { margin-top: 18px; margin-bottom: 5px; }
.studio-setting:disabled { opacity: 0.55; }
.footer Button:disabled { opacity: 0.4; }
.unity-collection-view__item--selected { background-color: rgb(42, 58, 74); }
.block-list .unity-collection-view__item--selected { background-color: rgba(0,0,0,0); }
.compact-layout .inspector { display: none; }
.compact-layout .body { padding: 22px 20px 14px; }
.compact-layout .sidebar { width: 204px; }
.narrow-layout .body { padding: 20px 16px 12px; }
.narrow-layout .studio-setting { max-width: 100%; }
.narrow-layout .subject-card { flex-basis: 45%; }
.narrow-layout .badge { display: none; }
.narrow-layout .page-location { margin-left: 12px; }

/* Desktop experience: readable logical pixels, native-resolution backing, task-first hierarchy. */
.workbench { background-color: rgb(18, 23, 29); color: rgb(232, 239, 246); font-size: 14px; letter-spacing: 0; }
.header { height: 72px; padding-left: 24px; padding-right: 28px; background-color: rgb(22, 28, 35); }
.brand { font-size: 20px; letter-spacing: .5px; }
.brand-detail { font-size: 10px; letter-spacing: .6px; color: rgb(143, 158, 172); }
.page-location { font-size: 13px; margin-left: 26px; }
.sidebar { width: 228px; padding: 22px 14px; background-color: rgb(20, 26, 33); }
.sidebar .unity-scroll-view__content-container { min-height: 100%; }
.sidebar .studio-button { min-height: 44px; padding: 10px 12px; margin-top: 2px; margin-bottom: 2px; }
.sidebar .studio-button Label { font-size: 13px; }
.sidebar .nav-heading { font-size: 10px; letter-spacing: .6px; margin: 18px 12px 10px; color: rgb(139, 155, 170); }
.nav-spacer { flex-grow: 1; min-height: 24px; }
.nav-foldout { margin: 18px 0 0; }
.nav-foldout > .unity-foldout__toggle { color: rgb(151, 168, 184); min-height: 32px; padding-left: 9px; font-size: 11px; }
.nav-foldout > .unity-foldout__content { margin-left: 0; }
.body { padding: 30px 32px 22px; }
.title { font-size: 29px; letter-spacing: -.3px; margin-bottom: 8px; }
.studio-subtitle { font-size: 13px; color: rgb(158, 176, 193); margin-bottom: 24px; }
.studio-icon { width: 20px; height: 20px; min-width: 20px; min-height: 20px; align-self: center; margin-top: 0; margin-bottom: 0; }
.studio-button { min-height: 38px; }
.studio-button > Label { padding: 0; margin: 0; -unity-text-align: middle-left; }
Button { font-size: 13px; height: 38px; padding: 8px 12px; border-radius: 6px; }
Button.primary { background-color: rgb(158, 213, 198); border-color: rgb(158, 213, 198); color: rgb(18, 46, 43); }
Button.primary:hover { background-color: rgb(184, 231, 218); border-color: rgb(184, 231, 218); }
Button.primary .studio-icon { color: rgb(24, 67, 58); }
Button.icon-button { width: 34px; height: 34px; min-height: 34px; padding: 7px; }
Button.text-link { background-color: rgba(0,0,0,0); border-width: 0; color: rgb(170, 205, 228); padding: 4px 0; margin: 0 18px 0 0; height: 30px; min-height: 30px; font-size: 11px; }
.text-link .studio-icon { width: 15px; height: 15px; min-width: 15px; min-height: 15px; margin-right: 7px; }
.footer { height: 76px; padding: 14px 28px; }
.footer .status { font-size: 12px; color: rgb(165, 183, 199); }
.footer .primary { min-width: 188px; height: 44px; font-size: 14px; }
.footer > Button { height: 40px; }
.start-welcome { margin-bottom: 26px; }
.eyebrow { font-size: 10px; letter-spacing: 1.2px; color: rgb(143, 195, 181); margin-bottom: 8px; }
.start-title { font-size: 35px; -unity-font-style: bold; letter-spacing: -.7px; margin-bottom: 9px; }
.start-subtitle { font-size: 14px; white-space: normal; color: rgb(163, 181, 197); }
.launch-workspace { align-items: flex-start; margin-bottom: 24px; flex-wrap: wrap; }
.launch-choices { flex-grow: 1; flex-basis: 440px; min-width: 320px; margin-right: 30px; margin-bottom: 10px; }
.world-choices { flex-grow: 1.3; flex-basis: 520px; min-width: 320px; }
.session-section-heading { min-height: 34px; margin: 0 0 12px; flex-wrap: wrap; }
.session-section-title { font-size: 15px; letter-spacing: -.1px; }
.session-hint { font-size: 12px; color: rgb(156, 174, 191); }
.movement-choices { align-items: stretch; margin: 0 0 14px; }
Button.movement-card { flex-grow: 1; flex-basis: 0; flex-shrink: 1; min-width: 0; height: 98px; align-items: center; justify-content: flex-start; padding: 16px 12px; margin: 0 10px 0 0; background-color: rgb(27, 36, 45); border-color: rgb(59, 76, 91); }
.movement-card > .studio-icon { width: 24px; height: 24px; min-width: 24px; min-height: 24px; margin-right: 12px; }
.movement-title { font-size: 17px; -unity-font-style: bold; margin-bottom: 6px; color: rgb(230, 240, 247); }
.movement-detail { font-size: 11px; white-space: normal; color: rgb(160, 180, 198); }
Button.movement-card.is-selected { background-color: rgb(29, 53, 53); border-color: rgb(117, 190, 171); border-width: 2px; padding: 15px 11px; }
.movement-card.is-selected .studio-icon { color: rgb(159, 215, 195); }
.tracking-choice { margin-bottom: 7px; }
.tracking-choice > DropdownField { flex-grow: 1; flex-direction: column; margin: 0 10px 0 0; }
.tracking-choice .unity-base-field__label { font-size: 11px; margin-bottom: 5px; color: rgb(161, 181, 198); }
.tracking-choice .unity-base-field__input { min-height: 36px; }
.tracking-explanation { font-size: 11px; white-space: normal; color: rgb(155, 175, 192); margin: 3px 8px 3px 0; min-height: 30px; }
.tracker-links { flex-wrap: wrap; }
.world-previews { align-items: stretch; }
Button.world-card { flex-grow: 1; flex-basis: 0; flex-shrink: 1; min-width: 0; height: auto; min-height: 206px; flex-direction: column; align-items: stretch; padding: 0; margin: 0 12px 0 0; overflow: hidden; background-color: rgb(28, 37, 46); border-color: rgb(58, 75, 90); border-radius: 8px; }
Button.world-card.is-selected { border-color: rgb(117, 190, 171); border-width: 2px; }
.world-image { width: 100%; height: 112px; flex-shrink: 0; }
.world-caption { min-height: 24px; margin: 12px 12px 6px; }
.world-caption .studio-icon { width: 17px; height: 17px; min-width: 17px; min-height: 17px; margin-right: 8px; }
.world-title { font-size: 14px; -unity-font-style: bold; color: rgb(227, 239, 247); }
.world-detail { font-size: 11px; white-space: normal; color: rgb(159, 180, 197); margin: 0 12px 14px; }
.session-plan { margin-bottom: 20px; }
.session-plan-holder { height: 64px; padding-bottom: 7px; }
.session-plan-row { height: 57px; padding: 8px 14px; background-color: rgb(27, 36, 46); border-width: 1px; border-color: rgb(45, 61, 76); border-radius: 6px; }
.session-plan-title { font-size: 13px; }
.session-plan-description { font-size: 11px; margin-top: 4px; }
.recording-details { border-top-width: 1px; border-top-color: rgb(49, 65, 78); padding-top: 10px; margin-top: 2px; margin-bottom: 8px; }
.recording-details > .unity-foldout__toggle { min-height: 44px; font-size: 13px; color: rgb(172, 192, 207); }
.recording-details > .unity-foldout__content { margin-left: 0; padding-top: 14px; }
.apparatus-summary { min-height: 36px; border-top-width: 1px; border-top-color: rgb(40, 54, 67); padding-top: 12px; margin-top: 6px; flex-wrap: wrap; }
.apparatus-summary .session-hint { font-size: 11px; margin-right: 20px; }
.session-details { height: auto; min-height: 100px; padding: 14px; }
.session-field > .unity-base-field__label, .subject-traits > .unity-base-field > .unity-base-field__label { font-size: 12px; height: auto; min-height: 18px; margin-bottom: 7px; }
.session-field .unity-text-field__input, .subject-traits .unity-base-popup-field__input { min-height: 36px; padding: 7px 9px; font-size: 13px; }
.subject-card { min-width: 250px; padding: 16px; }
.subject-card > .session-field { height: 66px; }
.subject-traits { height: 66px; }
.subject-traits > .unity-base-field { height: 66px; min-height: 66px; }
.subject-card > .session-comments { height: 82px; }
.unity-base-field__input { min-height: 32px; font-size: 13px; padding: 6px 8px; }
.setting-title { font-size: 13px; }
.studio-setting { min-height: 54px; padding: 11px 13px; border-radius: 6px; }
.section-heading > Label { font-size: 14px; }
.studio-dialog { background-color: rgb(22, 31, 41); border-radius: 10px; padding: 28px; }
.studio-dialog > Label { font-size: 13px; }
.hover-help Label { font-size: 13px; }
.compact-layout .body { padding: 26px 24px 18px; }
.narrow-layout .body { padding: 24px 20px 16px; }
.narrow-layout .launch-choices { flex-basis: 100%; margin-right: 0; }
.narrow-layout .world-choices { flex-basis: 100%; }
.narrow-layout .start-title { font-size: 30px; }

.quick-tracker-status { flex-wrap: wrap; min-height: 34px; margin-top: 4px; }
.tracker-app-state { font-size: 10px; color: rgb(149, 174, 190); margin-right: 12px; white-space: normal; flex-grow: 1; flex-basis: 100%; }
.desktop-preview-hud { position: absolute; left: 0; right: 0; top: 0; bottom: 0; color: rgb(232, 240, 245); font-size: 12px; }
.desktop-run-bar { position: absolute; left: 20px; top: 18px; flex-direction: row; align-items: center; padding: 9px 12px; border-width: 1px; border-color: rgba(139, 181, 173, .45); border-radius: 9px; background-color: rgba(14, 23, 29, .90); }
.desktop-input-badge { font-size: 10px; -unity-font-style: bold; letter-spacing: .5px; color: rgb(169, 221, 198); margin-right: 14px; }
.desktop-input-status { font-size: 11px; color: rgb(173, 204, 192); margin-right: 18px; }
.desktop-input-status.input-stale { color: rgb(230, 197, 137); }
Button.desktop-run-button { height: 31px; min-height: 31px; font-size: 11px; margin: 0 3px; padding: 5px 9px; background-color: rgb(38, 51, 62); border-color: rgb(67, 88, 104); }
Button.desktop-back-button { background-color: rgb(175, 218, 201); color: rgb(19, 48, 40); border-color: rgb(175, 218, 201); margin-left: 10px; }
.desktop-control-help { position: absolute; left: 20px; top: 84px; padding: 15px 18px; background-color: rgba(14, 23, 29, .94); border-radius: 8px; }
.desktop-control-help > Label { font-size: 12px; color: rgb(206, 224, 235); margin-bottom: 8px; white-space: normal; }

.movement-card .movement-detail, Button.world-card .world-detail { white-space: normal; }
.movement-card > VisualElement { min-width: 0; flex-basis: 0; }
.desktop-presentation { margin-bottom: 25px; padding-bottom: 18px; border-bottom-width: 1px; border-bottom-color: rgb(51, 67, 81); }
.desktop-presentation .unity-base-field { max-width: 480px; margin-left: 0; }
.viewer-launch-state { font-size: 11px; color: rgb(180, 199, 213); white-space: normal; margin-top: 5px; }
.session-field { min-height: 74px; }
.subject-card > .session-field { height: 74px; }
.subject-traits, .subject-traits > .unity-base-field { height: 74px; min-height: 74px; }
.subject-card > .session-comments { height: 90px; }
