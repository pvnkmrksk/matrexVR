/* Experiment control: one navigation rail, a shared workspace, compact property groups. */

.row { flex-direction: row; align-items: center; min-height: 32px; }
.header, .footer { flex-shrink: 0; background-color: rgb(27, 27, 27); }

.identity { width: 164px; flex-shrink: 0; }

.badge { color: rgb(154, 209, 200); font-size: 11px; padding: 5px 10px; margin-right: 18px; }
.frame-rate { color: rgb(186, 198, 210); font-size: 12px; min-width: 158px; -unity-text-align: middle-right; }
.clickable:hover { color: rgb(151, 210, 200); }
.clickable:focus { border-bottom-width: 1px; border-bottom-color: rgb(151, 210, 200); }
.main { flex-grow: 1; min-height: 0; align-items: stretch; }

.sidebar #navigation-title { margin-top: 0; }

.sidebar .studio-button:hover { background-color: rgb(39, 56, 73); color: rgb(255, 255, 255); }
.sidebar Button.nav-active { background-color: rgb(35, 80, 83); color: rgb(230, 251, 245); border-left-width: 3px; border-left-color: rgb(35, 78, 66); padding-left: 8px; }
.sidebar .nav-file { padding-left: 17px; }
.sidebar .nav-file Label { font-size: 12px; color: rgb(186, 204, 220); }
.sidebar Button.file-active { background-color: rgb(39, 56, 73); }
.sidebar Button.file-active Label { color: rgb(234, 247, 255); }

.location, .studio-subtitle { color: rgb(184, 197, 209); font-size: 12px; white-space: normal; margin-bottom: 18px; }
.studio-title-row { align-items: flex-start; }
.studio-title-row > .studio-button { margin-top: 0; }

.studio-button Label { white-space: nowrap; }

Button:hover { background-color: rgb(24, 28, 30); border-color: rgb(50, 70, 84); color: rgb(186, 205, 220); }
Button:focus { border-color: rgb(35, 74, 94); background-color: rgb(23, 28, 30); color: rgb(186, 205, 220); }

.primary .studio-icon { color: rgb(255, 255, 255); }
Button.quiet { background-color: rgb(26, 27, 28); }

.icon-button .studio-icon { margin-right: 0; width: 18px; height: 18px; }
Button.tab-active { background-color: rgb(22, 28, 27); color: rgb(157, 210, 202); border-color: rgb(44, 74, 67); }
.pill { font-size: 11px; border-radius: 3px; padding: 3px 7px; margin-right: 7px; white-space: normal; background-color: rgb(25, 27, 30); color: rgb(184, 198, 212); }
.pill.accent { background-color: rgb(22, 29, 26); color: rgb(159, 209, 195); }
.pill.muted-pill { background-color: rgba(0, 0, 0, 0); color: rgb(185, 197, 208); }
.pill.warm-pill { background-color: rgb(31, 27, 16); color: rgb(221, 194, 151); }
.pill.unit-pill { padding: 1px 4px; margin-left: 4px; margin-right: 2px; font-size: 11px; background-color: rgba(0, 0, 0, 0); color: rgb(185, 196, 206); }
.sequence-stats { margin-bottom: 10px; }
.sequence-flags { flex-wrap: wrap; margin-bottom: 8px; }
.sequence-flag { height: 34px; min-height: 34px; padding: 5px 9px; background-color: rgb(27, 27, 27); border-color: rgb(62, 68, 73); }
.sequence-flag .studio-icon { width: 17px; height: 17px; }
.sequence-flag.is-on { background-color: rgb(22, 28, 27); color: rgb(157, 210, 202); border-color: rgb(44, 74, 67); }
.flag-state { font-size: 10px; margin-left: 10px; color: rgb(184, 197, 208); }
.is-on .flag-state { color: rgb(157, 210, 202); }
.sequence-flags .unity-integer-field { width: 165px; margin-left: 15px; }
.sequence-flags .unity-base-field__label { min-width: 0; width: 108px; font-size: 10px; }
.run-options { margin-bottom: 9px; }
.run-option { flex-grow: 1; padding-right: 12px; }
.run-option > Label { margin-right: 10px; }
.block-list { flex-grow: 1; min-height: 0; margin-top: 8px; }
.block-holder { height: 156px; padding: 0 0 10px; }
.block-card { flex-grow: 1; padding: 14px 16px; border-width: 1px; border-color: rgb(63, 68, 72); border-radius: 6px; background-color: rgb(27, 27, 27); }
.block-card:hover { border-color: rgb(47, 71, 85); }
.unity-collection-view__item--selected .block-card { border-color: rgb(37, 76, 67); background-color: rgb(24, 28, 26); }
.block-heading { min-height: 26px; }
.block-number { font-size: 18px; -unity-font-style: bold; color: rgb(162, 203, 216); margin-right: 12px; }
.block-name { flex-grow: 1; flex-basis: 0; -unity-font-style: bold; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.block-description { color: rgb(184, 198, 212); font-size: 12px; white-space: normal; margin: 9px 0 7px; }
.block-bottom { min-height: 28px; }
.block-bottom Button { height: 28px; font-size: 11px; }
.block-reference { flex-grow: 1; flex-basis: 0; color: rgb(184, 195, 206); font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.builder-add-row { margin-top: 7px; }
.builder-add-row > Label { flex-grow: 1; flex-basis: 0; font-size: 12px; color: rgb(185, 196, 208); margin-left: 12px; white-space: normal; }
.inspector { width: 244px; flex-shrink: 0; padding: 26px 18px; background-color: rgb(25, 27, 29); border-left-width: 1px; border-left-color: rgb(63, 68, 72); }
.inspector Label { white-space: normal; }
.inspector .unity-scroll-view__content-container > Label { color: rgb(185, 199, 212); font-size: 12px; margin-bottom: 13px; }
.inspector #overview-title { font-size: 10px; letter-spacing: 0; color: rgb(184, 197, 209); }
.overview-duration { font-size: 28px; color: rgb(184, 205, 216); margin: 3px 0 8px; }
.inspector #selected-block-title { font-size: 16px; color: rgb(188, 204, 217); }
.inspector .pill { margin-bottom: 10px; }
.inspector .studio-setting { width: 100%; max-width: none; min-width: 0; margin: 3px 0; padding: 7px 0; border-width: 0; background-color: rgba(0,0,0,0); }
.inspector .studio-setting > .setting-label { min-width: 60px; }
.inspector .studio-button { margin: 5px 0; }
.inspector .unity-base-field { flex-direction: column; }
.inspector .unity-base-field__label { min-width: 0; margin-bottom: 5px; }
.health-card { padding: 12px 0; margin-top: 18px; border-top-width: 1px; border-top-color: rgb(63, 68, 72); }
.health-card Label { font-size: 12px; color: rgb(185, 199, 212); margin-bottom: 7px; }

.footer Button { flex-shrink: 0; }

.error { color: rgb(240, 183, 180); }
.warning { color: rgb(222, 194, 149); }
.phase-tabs { margin: 2px 0 10px; }
.phase-tabs Button { flex-grow: 1; font-size: 11px; }
.phase-enable { padding: 7px 12px; background-color: rgb(24, 28, 30); border-radius: 4px; margin-bottom: 10px; }
.phase-enable > Label { margin-right: 12px; }
.phase-hint { color: rgb(184, 197, 209); font-size: 12px; margin-left: 15px; }
.settings-tabs { margin-bottom: 18px; padding-bottom: 12px; border-bottom-width: 1px; border-bottom-color: rgb(63, 68, 71); flex-wrap: wrap; }
.settings-tabs Button { padding: 5px 14px; margin: 0 6px 3px 0; height: 34px; }
.settings-scroll { flex-grow: 1; min-height: 0; }
.settings-scroll .unity-scroll-view__content-container { min-width: 0; }
.settings-section { margin: 0 0 22px; max-width: 1340px; }
.section-heading { min-height: 30px; margin-bottom: 8px; }
.section-heading .studio-icon { width: 17px; height: 17px; }

.settings-grid { flex-direction: row; flex-wrap: wrap; align-items: stretch; }

.studio-setting:hover { border-color: rgb(53, 70, 82); }
.setting-label { min-height: 20px; margin: 0 0 5px; flex-wrap: wrap; align-items: center; }

.numeric-setting, .boolean-setting, .color-setting { flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; }
.numeric-setting > .setting-label, .boolean-setting > .setting-label, .color-setting > .setting-label { flex-grow: 1; flex-basis: 150px; margin: 0 8px 0 0; }
.boolean-setting { width: 320px; }
.boolean-setting > .setting-label { flex-basis: 180px; }
.container-setting { width: 100%; margin-right: 0; padding: 14px; background-color: rgb(25, 27, 29); min-height: 64px; }
.container-setting > .setting-label { margin-right: 12px; }
.container-setting > .setting-label > .setting-title { flex-grow: 1; }
.container-setting > .setting-label > .studio-switch { margin-left: 12px; }
.container-setting > .setting-label > .disclosure-button { margin-left: 16px; font-size: 11px; height: 28px; background-color: rgba(0,0,0,0); border-width: 0; }
.container-setting > .studio-switch { align-self: flex-start; margin-top: 0; margin-bottom: 8px; }
.container-setting > Foldout { margin: 3px 0 0; }
.container-setting > Foldout > .unity-foldout__toggle { display: none; }
.container-setting > Foldout > .unity-foldout__content { flex-direction: row; flex-wrap: wrap; margin-left: 0; padding-top: 8px; }
.container-setting .container-setting { background-color: rgb(26, 27, 28); }
.vector-setting { min-height: 64px; }
.vector-controls { flex-wrap: wrap; }
.vector-axis { flex-shrink: 0; margin-right: 10px; }
.vector-axis > Label { min-width: 16px; font-size: 11px; color: rgb(182, 197, 210); }
.number-control { flex-grow: 0; flex-shrink: 0; min-width: 64px; }
.spin-box { min-height: 28px; flex-shrink: 0; }
.exact-number { margin: 0; flex-grow: 0; flex-shrink: 0; }
.exact-number .unity-base-field__input { -unity-text-align: middle-right; min-height: 28px; padding: 4px 7px; }
.spin-arrows { width: 16px; height: 28px; flex-shrink: 0; margin-left: 2px; }
.spin-arrows Button { width: 16px; height: 14px; min-height: 14px; padding: 0; margin: 0; border-width: 0; font-size: 9px; border-radius: 2px; background-color: rgb(25, 27, 29); color: rgb(183, 200, 214); }
.number-control.with-slider { min-width: 112px; }
.number-control .unity-base-slider { width: 112px; min-height: 12px; margin: 5px 0 0; }
.unity-base-slider__tracker { height: 3px; background-color: rgb(32, 38, 42); border-width: 0; }
.unity-base-slider__dragger, .unity-base-slider__dragger-border { background-image: none; background-color: rgb(40, 127, 136); width: 11px; height: 11px; border-width: 0; border-radius: 7px; }
.color-control { flex-grow: 0; min-height: 28px; }
.color-control .unity-color-field { width: 68px; min-width: 68px; margin: 0; }
.color-hex { font-size: 11px; color: rgb(184, 197, 209); margin-left: 8px; }
.color-preview { height: 56px; border-radius: 4px; margin-bottom: 12px; }
.text-setting, .choice-setting { width: 320px; flex-direction: row; align-items: center; justify-content: space-between; }
.text-setting > .setting-label, .choice-setting > .setting-label { flex-grow: 1; flex-basis: 100px; margin: 0 8px 0 0; }
.text-setting > TextField, .choice-setting > DropdownField { width: 140px; flex-shrink: 0; margin: 0; }
.backend-setting { flex-direction: column; align-items: stretch; }
.backend-setting > .setting-label { flex-grow: 0; flex-basis: auto; margin: 0 0 5px; }
.backend-setting > DropdownField { width: auto; min-width: 0; }
.feature-grid { flex-wrap: wrap; }
.feature-card { width: 254px; padding: 12px; margin: 0 10px 10px 0; border-width: 1px; border-color: rgb(62, 68, 72); border-radius: 4px; background-color: rgb(27, 27, 27); }
.feature-card .row > Label { flex-grow: 1; font-size: 14px; -unity-font-style: bold; }
.feature-card > .pill { margin-top: 7px; margin-bottom: 7px; }
.feature-card Button { margin: 0; }
.studio-switch { min-height: 24px; margin: 0; flex-shrink: 0; padding: 2px; border-width: 1px; border-color: rgba(0,0,0,0); border-radius: 4px; }
.studio-switch:focus { border-color: rgb(35, 74, 94); }
.studio-switch .unity-toggle__checkmark { display: none; }
.studio-switch .unity-toggle__input { background-color: rgba(0,0,0,0); padding: 0; border-width: 0; flex-direction: row; align-items: center; }
.switch-track { width: 32px; height: 18px; border-radius: 10px; background-color: rgb(24, 28, 31); border-width: 1px; border-color: rgb(60, 68, 75); }
.switch-knob { position: absolute; left: 3px; top: 3px; width: 10px; height: 10px; border-radius: 7px; background-color: rgb(27, 27, 27); }
.is-on .switch-track { background-color: rgb(37, 129, 111); border-color: rgb(35, 76, 68); }
.is-on .switch-knob { left: 18px; background-color: rgb(27, 27, 27); }
.switch-indicator { font-size: 11px; color: rgb(184, 196, 206); margin-left: 7px; min-width: 22px; }
.is-on .switch-indicator { color: rgb(153, 210, 198); }
.rig-card { margin: 6px 0 10px; padding: 12px; border-width: 1px; border-color: rgb(62, 68, 72); border-radius: 5px; background-color: rgb(27, 27, 27); }
.rig-card > .unity-foldout__toggle { -unity-font-style: bold; margin-bottom: 9px; }
.unity-base-field { color: rgb(190, 202, 214); margin: 4px; min-width: 0; font-size: 14px; }

.unity-base-field__input:focus { border-color: rgb(35, 74, 94); }
.unity-base-field__label { color: rgb(185, 199, 212); font-size: 12px; }
.unity-base-popup-field__text { color: rgb(190, 203, 216); }
.unity-scroll-view__vertical-scroller { width: 8px; }
.unity-scroll-view__horizontal-scroller { display: none; }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }
.unity-scroller .unity-base-slider__tracker { width: 5px; background-image: none; background-color: rgb(25, 27, 29); }
.unity-scroller .unity-base-slider__dragger, .unity-scroller .unity-base-slider__dragger-border { width: 5px; background-image: none; background-color: rgb(31, 38, 45); border-width: 0; }
.session-scroll { flex-grow: 1; min-height: 0; }
.session-welcome { align-items: flex-start; margin-bottom: 10px; }

.session-details > .session-field { flex-grow: 1; flex-basis: 0; }
.session-details > .session-comments { flex-grow: 1.3; }

.session-comments .unity-text-field__input { min-height: 42px; white-space: normal; }

.session-section-heading > .session-hint { flex-grow: 1; flex-basis: 0; }
.subject-grid { flex-wrap: wrap; align-items: flex-start; }

.subject-heading { min-height: 28px; margin-bottom: 8px; }
.subject-heading > .pill { flex-shrink: 0; white-space: nowrap; }
.subject-name { flex-grow: 1; font-size: 16px; -unity-font-style: bold; }

.subject-traits > .session-field { margin-right: 0; }
.subject-traits > .unity-base-popup-field { flex-grow: 1.35; }
.subject-traits .unity-base-popup-field__text { font-size: 11px; }
.session-system { height: auto; min-height: 64px; padding: 10px 15px; margin: 0 0 13px; background-color: rgb(24, 28, 29); border-color: rgb(59, 69, 75); justify-content: flex-start; }
.session-system > #session-system-headline { flex-grow: 1; flex-basis: 0; margin: 0 12px; color: rgb(180, 201, 216); font-size: 12px; white-space: normal; -unity-text-align: middle-left; }
.session-system > Label { font-size: 12px; color: rgb(180, 201, 216); }

.experiment-link { min-height: 74px; height: auto; justify-content: flex-start; padding: 14px 18px; margin: 0 0 10px; }
.experiment-link > .studio-icon { margin-right: 15px; }
.timing-warning { padding: 8px 11px; margin-bottom: 12px; min-height: 36px; border-left-width: 2px; border-left-color: rgb(88, 65, 35); border-radius: 3px; background-color: rgb(30, 27, 18); }
.timing-warning > Label { flex-grow: 1; flex-basis: 0; color: rgb(223, 194, 150); font-size: 12px; white-space: normal; }
.timing-warning .studio-icon { width: 17px; height: 17px; color: rgb(223, 191, 137); }
.hover-help { position: absolute; padding: 16px; border-width: 1px; border-color: rgb(74, 101, 124); border-radius: 7px; background-color: rgb(30, 47, 63); }

.modal-shade { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(18, 32, 47, .50); }

.small-dialog { width: 530px; height: auto; min-height: 230px; max-height: 80%; }
.small-dialog > .unity-base-field { margin-bottom: 12px; }
.small-dialog TextField { max-width: 470px; }
.library-layout { flex-grow: 1; align-items: stretch; padding: 10px 0; }
.preset-list { flex-grow: 1; flex-basis: 0; }
.preset-card { height: 82px; padding: 10px; border-bottom-width: 1px; border-bottom-color: rgb(64, 68, 71); background-color: rgb(27, 27, 27); }
.preset-name { flex-grow: 1; }
.preset-card .key-hint { margin-left: 28px; }
.library-preview { width: 300px; margin-left: 16px; padding: 14px 18px; background-color: rgb(25, 27, 29); border-radius: 4px; }
.library-preview Label { margin-bottom: 16px; white-space: normal; }
.library-preview #preset-title { font-size: 20px; -unity-font-style: bold; color: rgb(185, 204, 218); }
.library-preview .unity-base-field { flex-direction: column; }
.breadcrumb { font-size: 12px; color: rgb(167, 202, 223); margin: 14px 0 8px; }
.parameter-tools { max-width: 1080px; flex-wrap: wrap; }
.parameter-tools > .search { width: 280px; min-width: 80px; flex-shrink: 1; margin-right: 14px; }
.parameter-tools > .search > .unity-base-field__label { min-width: 0; width: auto; margin-right: 6px; }
.parameter-tools > Toggle { flex-shrink: 0; margin-right: 12px; }
.fields { flex-grow: 1; min-height: 0; max-width: 1080px; margin: 12px 0; background-color: rgb(23, 31, 40); border-radius: 5px; }
.workbench .fields .unity-collection-view__item { background-color: rgba(0, 0, 0, 0); }
.workbench .fields .unity-collection-view__item:hover { background-color: rgb(32, 44, 56); }
.field-row { height: 64px; flex-direction: row; align-items: center; padding: 7px 12px; border-bottom-width: 1px; border-bottom-color: rgb(48, 62, 73); }
.field-row > .caption { width: 228px; max-width: 36%; margin-right: 14px; flex-shrink: 0; }
.field-row > .caption > Label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.field-title { color: rgb(213, 227, 238); -unity-font-style: bold; }
.key-hint { font-size: 11px; color: rgb(183, 196, 207); margin-top: 4px; }
.field-row .key-hint { color: rgb(161, 182, 200); }
.field-controls, .field-value { flex-grow: 1; flex-basis: 0; min-width: 0; }
.field-actions { flex-shrink: 0; margin-left: 8px; }
.field-actions > Button { flex-shrink: 0; }
.field-actions > Button:disabled { opacity: .4; }
.field-value > Button { margin-left: 0; }
.field-value > .property-choice, .field-value > .property-text, .field-value > .property-path,
.field-value > .asset-picker-control { min-width: 0; max-width: 100%; flex-shrink: 1; margin-left: 0; }
.field-value > .property-choice { width: 210px; }
.field-value > .property-text { width: 280px; }
.field-value > .property-path, .field-value > .asset-picker-control { width: 480px; }
.field-value > .property-choice .unity-base-popup-field__text { overflow: hidden; text-overflow: ellipsis; }
.workbench .field-value .unity-base-field:focus .unity-base-field__input,
.workbench .field-value .unity-base-field__input:focus { border-color: rgb(102, 170, 179); }
.narrow-layout .field-row > .caption { width: 168px; margin-right: 10px; }
.narrow-layout .parameter-tools > .search { width: 168px; }
Button.mini { height: 29px; padding: 3px 6px; font-size: 11px; }
.raw-json { flex-grow: 1; flex-basis: 0; flex-shrink: 1; min-height: 0; margin-top: 16px; }
.raw-json .unity-text-field__input { min-height: 0; white-space: normal; -unity-text-align: upper-left; }
.json-actions { flex-shrink: 0; min-height: 38px; margin-top: 8px; }
.metadata { flex-grow: 1; padding-top: 15px; }
.metadata Label { margin-top: 18px; margin-bottom: 5px; }
.metadata .metadata-scalar { max-width: 380px; }
.metadata .metadata-quantity > .unity-base-field__input { max-width: 112px; -unity-text-align: middle-right; }
.studio-setting:disabled { opacity: 1; background-color: rgb(26, 27, 29); border-color: rgb(64, 68, 71); }
.footer Button:disabled { opacity: 1; }
.unity-collection-view__item--selected { background-color: rgb(22, 29, 27); }
/* Sequence cards own selection/focus chrome, including when the list itself is focused. */
.workbench .block-list .unity-collection-view__item,
.workbench .block-list .unity-collection-view__item:focus,
.workbench .block-list .unity-collection-view__item--selected,
.workbench .block-list .unity-collection-view__item--selected:focus,
.workbench .block-list:focus .unity-collection-view__item--selected {
    background-color: rgba(0,0,0,0);
    border-color: rgba(0,0,0,0);
}
.workbench .block-list .unity-collection-view__item:focus .block-card {
    border-color: rgb(36, 76, 68);
    background-color: rgb(23, 28, 26);
}
.compact-layout .inspector { display: none; }

.compact-layout .sidebar { width: 204px; }

.narrow-layout .studio-setting { max-width: 100%; }
.narrow-layout .subject-card { flex-basis: 45%; }
.narrow-layout .badge { display: none; }
.narrow-layout .page-location { margin-left: 12px; }

/* Default dark desktop theme: 8 px rhythm, compact native controls, natural font spacing.
   These values target a 1920 × 1080 operator display; the panel handles DPI scaling. */
.workbench { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(26, 27, 28); color: rgb(193, 203, 214); font-size: 14px; letter-spacing: 0; word-spacing: 0; }
.header { height: 64px; padding: 0 24px; border-bottom-width: 1px; border-bottom-color: rgb(64, 68, 72); background-color: rgb(27, 27, 27); padding-left: 20px; padding-right: 24px; }
.brand { font-size: 20px; -unity-font-style: bold; letter-spacing: 0; color: rgb(193, 204, 215); }
.brand-detail { color: rgb(185, 196, 208); font-size: 10px; letter-spacing: 0; margin-top: 3px; }
.page-location { flex-grow: 1; flex-basis: 0; color: rgb(186, 198, 210); font-size: 13px; margin-left: 16px; overflow: hidden; text-overflow: ellipsis; }
.sidebar { width: 208px; flex-shrink: 0; padding: 20px 10px; background-color: rgb(25, 36, 49); border-right-width: 1px; border-right-color: rgb(25, 36, 49); color: rgb(227, 235, 243); }
.sidebar .unity-scroll-view__content-container { min-height: 100%; }
.sidebar .studio-button { min-height: 40px; height: auto; justify-content: flex-start; margin: 2px 0; padding: 8px 12px; border-width: 0; background-color: rgba(0, 0, 0, 0); color: rgb(227, 235, 243); border-radius: 5px; margin-top: 2px; margin-bottom: 2px; }
.sidebar .studio-button Label { flex-grow: 1; flex-basis: 0; white-space: normal; -unity-text-align: middle-left; font-size: 14px; color: rgb(227, 235, 243); }
.sidebar .nav-heading { color: rgb(159, 179, 198); font-size: 10px; letter-spacing: 0; margin: 22px 12px 8px; }
.nav-spacer { flex-grow: 1; min-height: 24px; }
.nav-foldout { margin: 16px 0 0; }
.nav-foldout > .unity-foldout__toggle { color: rgb(195, 212, 227); min-height: 32px; padding-left: 9px; font-size: 12px; background-color: rgba(0, 0, 0, 0); border-width: 0; }
.nav-foldout > .unity-foldout__content { margin-left: 0; }
.body { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; padding: 26px 28px 20px; }
.title { font-size: 27px; -unity-font-style: bold; margin-bottom: 6px; white-space: normal; color: rgb(193, 204, 215); letter-spacing: 0; }
.studio-subtitle { font-size: 12px; color: rgb(184, 197, 209); margin-bottom: 18px; }
.studio-icon { width: 18px; height: 18px; flex-shrink: 0; margin-right: 8px; color: rgb(175, 200, 216); min-width: 18px; min-height: 18px; align-self: center; margin-top: 0; margin-bottom: 0; }
.studio-button { flex-direction: row; align-items: center; justify-content: center; min-height: 32px; }
.studio-button > Label { padding: 0; margin: 0; letter-spacing: 0; -unity-text-align: middle-left; }
Button { background-color: rgb(27, 27, 27); color: rgb(190, 203, 215); border-width: 1px; border-color: rgb(62, 68, 73); border-radius: 5px; padding: 6px 11px; margin: 3px; height: 34px; font-size: 13px; min-height: 28px; flex-shrink: 0; }
Button.primary { background-color: rgb(23, 111, 99); border-color: rgb(23, 111, 99); color: rgb(255, 255, 255); -unity-font-style: bold; }
Button.primary:hover { background-color: rgb(18, 90, 81); border-color: rgb(18, 90, 81); color: rgb(255, 255, 255); }
Button.primary .studio-icon { color: rgb(255, 255, 255); }
Button.icon-button { width: 34px; height: 34px; padding: 7px; margin: 0 2px; border-width: 0; background-color: rgba(0,0,0,0); min-height: 34px; }
Button.text-link { background-color: rgba(0,0,0,0); border-width: 0; color: rgb(189, 201, 212); padding: 4px 0; margin: 0 18px 0 0; height: 30px; min-height: 30px; font-size: 11px; }
.text-link .studio-icon { width: 15px; height: 15px; min-width: 15px; min-height: 15px; margin-right: 7px; }
.footer { height: 64px; padding: 10px 24px; border-top-width: 1px; border-top-color: rgb(64, 68, 72); background-color: rgb(27, 27, 27); }
.footer .status { flex-grow: 1; flex-basis: 0; min-width: 0; color: rgb(184, 198, 211); font-size: 12px; white-space: normal; }
.footer .primary { min-width: 176px; margin-left: 12px; height: 38px; font-size: 13px; }
.footer > Button { height: 34px; }
.start-welcome { margin-bottom: 16px; }
.eyebrow { font-size: 11px; letter-spacing: 0; color: rgb(150, 210, 199); margin-bottom: 8px; }
.start-title { font-size: 30px; -unity-font-style: bold; letter-spacing: 0; margin-bottom: 6px; color: rgb(188, 205, 218); }
.start-subtitle { font-size: 14px; white-space: normal; color: rgb(184, 199, 212); }
.launch-workspace { align-items: flex-start; margin-bottom: 24px; flex-wrap: wrap; }
.launch-choices { flex-grow: 1; flex-basis: 440px; min-width: 320px; margin-right: 30px; margin-bottom: 10px; }
.world-choices { flex-grow: 1.3; flex-basis: 520px; min-width: 320px; }
.session-section-heading { margin: 0 0 10px; min-height: 28px; flex-wrap: wrap; }
.session-section-title { -unity-font-style: bold; font-size: 15px; margin-right: 16px; color: rgb(186, 204, 218); letter-spacing: 0; }
.session-hint { color: rgb(184, 197, 209); font-size: 12px; white-space: normal; }
.movement-choices { align-items: stretch; margin: 0 0 14px; }
Button.movement-card { flex-grow: 1; flex-basis: 0; flex-shrink: 1; min-width: 0; height: 98px; align-items: center; justify-content: flex-start; padding: 16px 12px; margin: 0 10px 0 0; background-color: rgb(27, 27, 27); border-color: rgb(61, 68, 74); }
.movement-card > .studio-icon { width: 24px; height: 24px; min-width: 24px; min-height: 24px; margin-right: 12px; }
.movement-title { font-size: 17px; -unity-font-style: bold; margin-bottom: 6px; color: rgb(185, 204, 217); }
.movement-detail { font-size: 12px; white-space: normal; color: rgb(181, 199, 212); }
Button.movement-card.is-selected { background-color: rgb(23, 28, 26); border-color: rgb(35, 77, 66); border-width: 2px; padding: 15px 11px; }
.movement-card.is-selected .studio-icon { color: rgb(151, 210, 195); }
.tracking-choice { margin-bottom: 7px; }
.tracking-choice > DropdownField { flex-grow: 1; flex-direction: column; margin: 0 10px 0 0; }
.tracking-choice .unity-base-field__label { font-size: 12px; margin-bottom: 5px; color: rgb(183, 199, 212); }
.tracking-choice .unity-base-field__input { min-height: 36px; }
.tracking-explanation { font-size: 12px; white-space: normal; color: rgb(181, 198, 211); margin: 3px 8px 3px 0; min-height: 30px; }
.tracker-links { flex-wrap: wrap; }
.world-previews { align-items: stretch; }
Button.world-card { flex-grow: 1; flex-basis: 0; flex-shrink: 1; min-width: 0; height: auto; min-height: 186px; flex-direction: column; align-items: stretch; padding: 0; margin: 0 14px 0 0; overflow: hidden; background-color: rgb(27, 27, 27); border-color: rgb(62, 68, 73); border-radius: 7px; max-width: 400px; }
Button.world-card.is-selected { border-color: rgb(35, 77, 66); border-width: 2px; }
.world-image { width: 100%; height: 100px; flex-shrink: 0; }
.world-caption { min-height: 24px; margin: 10px 14px 4px; }
.world-caption .studio-icon { width: 17px; height: 17px; min-width: 17px; min-height: 17px; margin-right: 8px; }
.world-title { font-size: 15px; -unity-font-style: bold; color: rgb(186, 204, 217); }
.world-detail { font-size: 12px; white-space: normal; color: rgb(182, 198, 211); margin: 0 14px 12px; }
.session-plan { flex-shrink: 0; margin-bottom: 20px; }
.session-plan-holder { height: 64px; padding-bottom: 7px; }
.session-plan-row { height: 57px; padding: 8px 14px; border-radius: 6px; background-color: rgb(27, 27, 27); border-color: rgb(62, 68, 72); border-width: 1px; }
.session-plan-title { font-size: 14px; -unity-font-style: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: rgb(187, 203, 216); }
.session-plan-description { font-size: 12px; color: rgb(184, 197, 210); margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.recording-details { border-top-width: 1px; border-top-color: rgb(63, 68, 71); padding-top: 10px; margin-top: 4px; margin-bottom: 8px; }
.recording-details > .unity-foldout__toggle { min-height: 32px; font-size: 14px; color: rgb(183, 201, 215); background-color: rgba(0, 0, 0, 0); border-width: 0; align-self: flex-start; padding: 4px 0; }
.recording-details > .unity-foldout__content { margin-left: 0; padding-top: 12px; }
.apparatus-summary { min-height: 36px; border-top-width: 1px; border-top-color: rgb(63, 68, 71); padding-top: 12px; margin-top: 6px; flex-wrap: wrap; }
.apparatus-summary .session-hint { font-size: 11px; margin-right: 20px; }
.session-details { align-items: flex-start; height: auto; min-height: 88px; padding: 14px; margin-bottom: 10px; border-width: 1px; border-color: rgb(63, 68, 72); border-radius: 5px; background-color: rgb(27, 27, 27); }
.session-field > .unity-base-field__label, .subject-traits > .unity-base-field > .unity-base-field__label { min-width: 0; font-size: 12px; margin-bottom: 7px; height: auto; color: rgb(185, 199, 212); min-height: 18px; }
.session-field .unity-text-field__input, .subject-traits .unity-base-popup-field__input { min-height: 36px; padding: 7px 9px; font-size: 13px; }
.subject-card { flex-grow: 1; flex-basis: 22%; min-width: 250px; margin: 0 10px 12px 0; padding: 16px; border-width: 1px; border-color: rgb(62, 68, 72); border-radius: 5px; background-color: rgb(27, 27, 27); }

.subject-traits { align-items: flex-start; height: 66px; margin-bottom: 8px; }
.subject-traits > .unity-base-field { flex-direction: column; align-items: stretch; height: 66px; min-height: 66px; min-width: 0; flex-basis: 0; flex-grow: 1; margin: 0 10px 0 0; }

.unity-base-field__input { background-color: rgb(27, 27, 27); color: rgb(190, 203, 216); border-width: 1px; border-color: rgb(60, 68, 75); border-radius: 3px; min-height: 32px; padding: 5px 8px; font-size: 14px; letter-spacing: 0; }
.setting-title { font-size: 14px; color: rgb(188, 202, 214); white-space: normal; }
.studio-setting { width: 320px; min-height: 64px; padding: 9px 12px; margin: 0 10px 10px 0; background-color: rgb(27, 27, 27); border-width: 1px; border-color: rgb(64, 68, 72); border-radius: 5px; }
.section-heading > Label { flex-grow: 1; font-size: 14px; -unity-font-style: bold; color: rgb(187, 204, 217); }
.studio-dialog { width: 1000px; max-width: 95%; height: 700px; max-height: 90%; padding: 24px; background-color: rgb(27, 27, 27); border-width: 1px; border-color: rgb(59, 68, 76); border-radius: 9px; }
.studio-dialog > Label { color: rgb(184, 198, 210); font-size: 13px; margin: 4px 0 16px; white-space: normal; }
.hover-help Label { white-space: normal; font-size: 14px; color: rgb(242, 247, 251); }
.compact-layout .body { padding: 20px 20px 14px; }
.narrow-layout .body { padding: 18px 16px 12px; }
.narrow-layout .launch-choices { flex-basis: 100%; margin-right: 0; }
.narrow-layout .world-choices { flex-basis: 100%; }
.narrow-layout .start-title { font-size: 30px; }

.quick-tracker-status { flex-wrap: wrap; min-height: 34px; margin-top: 4px; }
.tracker-app-state { font-size: 10px; color: rgb(189, 201, 212); margin-right: 12px; white-space: normal; flex-grow: 1; flex-basis: 100%; }
/* The same labelled actions become a compact icon rail when requested. */
.navigation-toggle { margin-right: 14px; }
.navigation-collapsed .sidebar { width: 68px; padding-left: 10px; padding-right: 10px; }
.navigation-collapsed .sidebar .studio-button { justify-content: center; padding: 10px; }
.navigation-collapsed .sidebar .studio-button Label { display: none; }
.navigation-collapsed .sidebar .studio-icon { margin-right: 0; }
.navigation-collapsed .sidebar .nav-heading, .navigation-collapsed .sidebar .nav-foldout { display: none; }

/* Acquisition preparation is available before the experiment starts. */
Button#initialize-tracking { align-self: flex-start; flex-grow: 0; height: 34px; background-color: rgb(24, 28, 30); border-color: rgb(55, 69, 80); color: rgb(171, 203, 225); margin-left: 0; margin-right: 10px; }
Button#initialize-tracking:hover { background-color: rgb(21, 28, 33); border-color: rgb(46, 71, 89); }
.effective-json-dialog { width: 860px; max-width: 90%; }
.effective-json-dialog .raw-json { margin: 10px 0; }

.sequence-starter-dialog { width: 640px; }
.sequence-starter-dialog > DropdownField { flex-direction: column; margin: 4px 0 14px; }
.sequence-starter-dialog > DropdownField > .unity-base-field__label { margin-bottom: 6px; }
.sequence-starter-timing { color: rgb(151, 210, 196); font-size: 13px; margin: 4px 0 8px; }
.sequence-starter-reference { color: rgb(183, 196, 208); font-size: 12px; white-space: normal; margin-bottom: 18px; }
.sequence-starter-actions { justify-content: flex-end; flex-wrap: wrap; }

.sidebar .studio-icon { color: rgb(184, 210, 227); }

Button.primary:focus { background-color: rgb(18, 90, 81); border-color: rgb(35, 74, 94); color: rgb(255, 255, 255); }

.workbench Button > Label, .workbench Button:hover > Label { color: rgb(190, 203, 215); }
.workbench Button.primary > Label, .workbench Button.primary:hover > Label { color: rgb(255, 255, 255); }
.workbench .sidebar Button > Label, .workbench .sidebar Button:hover > Label { color: rgb(227, 235, 243); }
.workbench Button:disabled { color: rgb(185, 197, 208); background-color: rgb(25, 27, 29); border-color: rgb(64, 68, 71); opacity: 1; }
.workbench Button:disabled > Label { color: rgb(185, 197, 208); }
.workbench .studio-setting:disabled .setting-title, .workbench .studio-setting:disabled .unity-base-field__input { color: rgb(185, 197, 208); }
.workbench .studio-setting:disabled .unity-base-field__input { background-color: rgb(26, 27, 28); border-color: rgb(62, 68, 72); }
.workbench .studio-setting:disabled .studio-switch { opacity: .65; }
.workbench .sidebar .nav-foldout > .unity-foldout__toggle:hover { background-color: rgb(39, 56, 73); }
.workbench .unity-foldout__toggle { border-width: 0; background-color: rgba(0, 0, 0, 0); }
.workbench .unity-foldout__toggle:hover { background-color: rgb(24, 28, 30); }
.workbench .sidebar .unity-foldout__toggle { color: rgb(194, 212, 227); }
.workbench .unity-foldout__toggle > .unity-toggle__checkmark { -unity-background-image-tint-color: rgb(182, 197, 210); }
.workbench .sidebar .unity-foldout__toggle > .unity-toggle__checkmark { -unity-background-image-tint-color: rgb(174, 197, 215); }
.hover-help .hover-help-title { font-size: 15px; -unity-font-style: bold; margin: 0 0 8px; color: rgb(255, 255, 255); }
.hover-help .hover-help-body { font-size: 14px; color: rgb(241, 247, 251); }
.hover-help .hover-help-facts { font-size: 12px; color: rgb(190, 224, 221); margin-top: 12px; padding-top: 10px; border-top-width: 1px; border-top-color: rgb(77, 102, 123); }
.hover-help-scroll { min-height: 0; flex-shrink: 1; }

/* Running stimulus overlays keep their dark, high-contrast treatment. */
.desktop-preview-hud { position: absolute; left: 0; right: 0; top: 0; bottom: 0; color: rgb(232, 240, 245); font-size: 12px; }
.desktop-run-bar { position: absolute; left: 20px; top: 18px; flex-direction: row; align-items: center; padding: 9px 12px; border-width: 1px; border-color: rgba(52, 71, 68,.45); border-radius: 9px; background-color: rgba(14, 23, 29, .90); }
.desktop-input-badge { font-size: 10px; -unity-font-style: bold; letter-spacing: .5px; color: rgb(169, 221, 198); margin-right: 14px; }
.desktop-input-status { font-size: 11px; color: rgb(173, 204, 192); margin-right: 18px; }
.desktop-input-status.input-stale { color: rgb(230, 197, 137); }

Button.desktop-back-button { background-color: rgb(24, 41, 34); color: rgb(189, 207, 202); border-color: rgb(52, 72, 64); margin-left: 10px; }
.desktop-control-help { position: absolute; left: 20px; top: 84px; padding: 15px 18px; background-color: rgba(14, 23, 29, .94); border-radius: 8px; }
.desktop-control-help > Label { font-size: 12px; color: rgb(206, 224, 235); margin-bottom: 8px; white-space: normal; }

.movement-card .movement-detail, Button.world-card .world-detail { white-space: normal; }
.movement-card > VisualElement { min-width: 0; flex-basis: 0; }
.desktop-presentation { margin-bottom: 25px; padding-bottom: 18px; border-bottom-width: 1px; border-bottom-color: rgb(51, 67, 81); }
.desktop-presentation .unity-base-field { max-width: 480px; margin-left: 0; }
.viewer-launch-state { color: rgb(180, 199, 213); font-size: 11px; white-space: normal; margin-top: 5px; }
.session-field { flex-grow: 0; min-width: 0; flex-direction: column; align-items: stretch; margin: 0 12px 9px 0; min-height: 64px; }
.subject-card > .session-field { margin: 0 0 5px; height: 64px; }
.subject-traits, .subject-traits > .unity-base-field { height: 64px; min-height: 64px; }
.subject-card > .session-comments { height: 82px; margin-bottom: 0; }

Button.desktop-run-button { height: 31px; min-height: 31px; font-size: 11px; margin: 0 3px; padding: 5px 9px; background-color: rgb(38, 51, 62); border-color: rgb(67, 88, 104); color: rgb(224, 238, 247); }

.unity-base-popup-field__arrow { -unity-background-image-tint-color: rgb(179, 200, 215); }
.unity-base-dropdown__container-outer, .unity-base-dropdown__container-inner { background-color: rgb(27, 27, 27); border-color: rgb(59, 69, 76); }
.unity-base-dropdown__item { color: rgb(184, 203, 218); background-color: rgb(27, 27, 27); min-height: 30px; padding: 5px 12px; font-size: 13px; }
.unity-base-dropdown__item:hover, .unity-base-dropdown__item--selected { background-color: rgb(22, 28, 26); color: rgb(155, 210, 196); }

/* Start uses two bounded work areas instead of full-width horizontal dividers. */
.home-overview { align-items: flex-start; flex-wrap: wrap; margin-bottom: 20px; }
.home-launcher { flex-grow: 1; flex-basis: 690px; min-width: 560px; max-width: 820px; margin: 0 28px 16px 0; }
.home-sequence { flex-grow: 1; flex-basis: 600px; min-width: 460px; padding: 22px; background-color: rgb(27, 27, 27); border-width: 1px; border-color: rgb(62, 68, 73); border-radius: 8px; }
.home-sequence .session-section-heading { flex-wrap: wrap; margin-bottom: 14px; }
.home-sequence .session-section-heading > .session-hint { flex-basis: 100%; margin: 2px 0 12px 26px; }
.home-sequence .session-section-heading > Button { margin: 0 6px 0 0; }
.home-sequence .session-plan-row { background-color: rgb(25, 27, 29); }
.home-sequence .session-plan-description { font-size: 11px; }
.home-sequence .pill { font-size: 10px; }
.recording-summary { flex-wrap: wrap; min-height: 52px; padding: 9px 12px; margin: 4px 0 14px; border-width: 1px; border-color: rgb(59, 69, 72); background-color: rgb(24, 28, 28); border-radius: 6px; }
.recording-summary-title { font-size: 14px; -unity-font-style: bold; color: rgb(167, 207, 208); margin-right: 14px; }
.recording-summary-state { font-size: 13px; color: rgb(168, 204, 206); flex-grow: 1; flex-basis: 200px; }
.recording-summary Button { height: 30px; }
.narrow-layout .home-launcher { min-width: 0; flex-basis: 100%; margin-right: 0; }
.narrow-layout .home-sequence { min-width: 0; flex-basis: 100%; }

.workbench .unity-base-field:focus .unity-base-field__input { border-color: rgb(35, 74, 94); }
.workbench .studio-switch:focus { background-color: rgb(22, 28, 31); border-color: rgb(35, 74, 94); }
.workbench Button:hover .studio-icon { color: rgb(164, 204, 231); }
.workbench Button.primary:hover .studio-icon { color: rgb(255, 255, 255); }
.workbench .sidebar Button:hover .studio-icon { color: rgb(218, 242, 255); }
.inspector .studio-button { height: auto; min-height: 34px; justify-content: flex-start; padding: 7px 9px; }
.inspector .studio-button > Label { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; white-space: normal; font-size: 12px; }
.inspector .studio-setting { min-height: 54px; }
.workbench .world-card > .world-detail { margin: 0 14px 12px; }
.workbench .sequence-flag > .flag-state { margin-left: 10px; color: rgb(184, 197, 208); font-size: 10px; }
.workbench .sequence-flag.is-on > .flag-state { color: rgb(157, 210, 202); }

.studio-dialog.small-dialog { height: auto; min-height: 230px; max-height: 80%; }
/* Foldout is a Toggle; its inner input must not inherit text-field chrome. */
.workbench .unity-toggle > .unity-base-field__input { background-color: rgba(0, 0, 0, 0); border-width: 0; padding: 0; min-height: 24px; }
.workbench .sidebar .unity-foldout__toggle .unity-toggle__text { color: rgb(195, 212, 227); font-size: 12px; }
.workbench .sidebar .unity-foldout__toggle .unity-base-field__label { color: rgb(195, 212, 227); }
/* Specialized field geometry must win over the shared scalar-card rule. */
.settings-grid { align-items: flex-start; }
.studio-setting.vector-setting { width: 520px; max-width: 100%; }
.studio-setting.path-setting { width: 650px; max-width: 100%; flex-wrap: wrap; }
.studio-setting.path-setting > TextField { width: 450px; min-width: 0; max-width: 100%; flex-shrink: 1; }
.narrow-layout .studio-setting.path-setting { flex-direction: column; align-items: stretch; }
.narrow-layout .studio-setting.path-setting > .setting-label { flex-grow: 0; flex-basis: auto; margin: 0 0 5px; }
.studio-setting.container-setting { width: 100%; margin-right: 0; }
.workbench .unity-base-slider > .unity-base-field__input { background-color: rgba(0, 0, 0, 0); border-width: 0; padding: 0; min-height: 12px; }
.studio-setting.container-setting { width: 320px; margin-right: 10px; }
.studio-setting.container-setting.parameters-open { width: 100%; margin-right: 0; }

.studio-dialog.small-dialog { width: 560px; }
.studio-dialog.sequence-starter-dialog { width: 640px; }
.studio-dialog.small-dialog > Button.primary { align-self: flex-end; min-width: 140px; }
.workbench .sidebar .unity-foldout__toggle .unity-foldout__checkmark { -unity-background-image-tint-color: rgb(190, 212, 230); }
.settings-scroll .add-parameter-action, .settings-scroll #show-omitted-settings { align-self: flex-start; margin: 3px 0 10px; }
.subject-card { flex-grow: 0; flex-basis: 380px; max-width: 430px; }
/* Disabled must win even when the pointer remains over a primary action. */
.workbench Button.primary:disabled > Label,
.workbench Button.primary:disabled:hover > Label,
.workbench Button.primary:disabled .studio-icon,
.workbench Button.primary:disabled:hover .studio-icon { color: rgb(185, 197, 208); }
/* Reserve enough selected-text width for full enum names beside the arrow. */
.studio-setting.choice-setting > DropdownField { width: 188px; }
.sequence-override-note { flex-shrink: 0; max-width: 1340px; padding: 12px 14px; margin-bottom: 14px; border-width: 1px; border-left-width: 3px; border-color: rgb(76, 67, 44); background-color: rgb(30, 27, 20); border-radius: 5px; }
.sequence-override-title { font-size: 14px; -unity-font-style: bold; color: rgb(216, 196, 162); margin-bottom: 5px; }
.sequence-override-roles { flex-wrap: wrap; margin-bottom: 4px; }
.sequence-override-copy { font-size: 13px; color: rgb(211, 196, 166); white-space: normal; margin-bottom: 8px; }
.sequence-override-note > Button { align-self: flex-start; margin-left: 0; }

/* Deliberately dark regardless of the operating system appearance. */
.workbench { background-color: rgb(20, 26, 33); color: rgb(215, 225, 233); }
.workbench .unity-base-field__input { background-color: rgb(28, 37, 47); color: rgb(221, 232, 241); border-color: rgb(66, 84, 99); }
.workbench .unity-base-field__label { color: rgb(194, 209, 222); }
.workbench .unity-text-field__input { color: rgb(225, 235, 244); }
.workbench .unity-base-dropdown__container-outer, .workbench .unity-base-dropdown__container-inner { background-color: rgb(28, 37, 47); color: rgb(221, 232, 241); }
.workbench .unity-base-dropdown__item:hover { background-color: rgb(43, 65, 77); }
.config-identity { flex-wrap: wrap; margin-bottom: 6px; }
.config-identity > TextField { flex-grow: 1; max-width: 780px; }
.config-identity .unity-base-field__label { min-width: 130px; }
#config-comments-foldout { margin-bottom: 12px; }
#config-comments { min-height: 48px; max-width: 1000px; }
.config-reference { color: rgb(140, 161, 180); font-size: 11px; margin-bottom: 10px; white-space: normal; }
.phase-continuity { margin: 0 0 12px; }
.phase-continuity > Label { margin-right: 14px; }
.sequence-seed { flex-wrap: wrap; margin-left: 12px; }
.sequence-seed > .unity-base-field { margin-right: 12px; max-width: 240px; }
.sequence-seed .unity-base-field__label { min-width: 48px; width: auto; margin-right: 8px; }
.apparatus-count-presets { flex-wrap: wrap; margin-bottom: 10px; }
.apparatus-count-presets > Label { margin-right: 10px; margin-bottom: 0; }

/* Value changes keep their controls and positions. Only navigation and explicit
   disclosure/add/remove actions change the form's structure. */
.workbench .studio-switch .unity-toggle__checkmark { display: flex; width: 19px; height: 19px; min-width: 19px; min-height: 19px; margin-right: 6px; border-radius: 3px; }
.workbench .studio-switch .unity-toggle__input { min-height: 24px; padding: 0; }
.workbench .studio-switch .unity-toggle__text { font-size: 12px; color: rgb(210, 224, 235); white-space: nowrap; }
.workbench .studio-switch:disabled { opacity: .55; }
.workbench .studio-setting:disabled { opacity: .62; }
.workbench .studio-setting .pill { white-space: nowrap; }
.studio-setting.container-setting, .studio-setting.container-setting.parameters-open { width: 100%; margin-right: 0; }
.settings-tabs { flex-wrap: wrap; align-items: stretch; }
.settings-tabs > .studio-button { flex-direction: column; justify-content: center; width: 108px; height: 66px; padding: 7px 4px; flex-shrink: 0; }
.settings-tabs > .studio-button > .studio-icon { width: 20px; height: 20px; margin: 0 0 5px; }
.settings-tabs > .studio-button > Label { font-size: 11px; -unity-text-align: middle-center; }
.phase-tabs > Button { height: 44px; min-height: 44px; min-width: 0; flex-basis: 0; }
.phase-tabs > Button > Label { flex-shrink: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sequence-option { min-width: 130px; height: 36px; margin: 0 10px 6px 0; padding: 4px 8px; border-radius: 4px; background-color: rgb(28, 37, 47); }
.sequence-option > .studio-icon { width: 18px; height: 18px; margin-right: 7px; }
.sequence-flags > .unity-integer-field { width: 190px; margin: 0 12px 6px 0; }
.sequence-seed { min-height: 36px; margin: 0 0 6px; }
.asset-picker-control { min-height: 70px; }
.asset-picker-control > DropdownField, .asset-picker-control > TextField { min-height: 32px; width: 100%; margin: 0 0 4px; }
.spin-arrows > .icon-button { padding: 0 2px; }
.spin-arrows > .icon-button > .studio-icon { width: 12px; height: 11px; margin: 0; }
.footer > #start-experiment { width: 204px; min-width: 204px; max-width: 204px; }
.footer > #save-changes { width: 156px; min-width: 156px; max-width: 156px; }
.footer > Button > Label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.recording-control-mode { min-height: 65px; margin: 2px 0 10px; }
.recording-control-mode > DropdownField { flex-direction: column; }
.recording-control-help { min-height: 34px; max-height: 48px; font-size: 11px; white-space: normal; color: rgb(179, 199, 212); }
.recording-control-status { min-height: 28px; max-height: 40px; font-size: 11px; white-space: normal; color: rgb(160, 209, 198); }

.recording-control-help { height: 48px; min-height: 48px; max-height: 48px; overflow: hidden; }
.recording-control-status { height: 40px; min-height: 40px; max-height: 40px; overflow: hidden; }
.sequence-seed > #sequence-seed-mode { width: 228px; min-width: 228px; max-width: 228px; flex-shrink: 0; }
.sequence-seed > #sequence-random-seed { width: 165px; min-width: 165px; max-width: 165px; flex-shrink: 0; }
/* The inspector is a narrow column; scalar cards must never inherit the
   horizontal two-column field geometry from the main parameter canvas. */
.workbench .inspector .studio-setting { flex-direction: column; align-items: stretch; width: 100%; min-width: 0; max-width: 100%; }
.workbench .inspector .studio-setting > .setting-label { flex-grow: 0; flex-basis: auto; width: 100%; margin: 0 0 6px; }
.workbench .inspector .setting-title { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.workbench .inspector .studio-setting > TextField,
.workbench .inspector .studio-setting > DropdownField,
.workbench .inspector .studio-setting > .number-control { width: 100%; max-width: 100%; }
.workbench .inspector .studio-setting.container-setting,
.workbench .inspector .studio-setting.vector-setting,
.workbench .inspector .studio-setting.path-setting { width: 100%; min-width: 0; max-width: 100%; }
.workbench .inspector .vector-controls { flex-wrap: wrap; }
.workbench .inspector .vector-axis { margin-right: 0; }
.workbench .sidebar .nav-file Label { flex-grow: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }

/* Visibility remains a fixed matrix while inactive rigs and features dim. */
.studio-setting.visibility-setting { width: 100%; min-width: 460px; }

/* Thumbnails reserve geometry before async loading and never run in acquisition. */
.edit-rendered-preview { height: 170px; min-height: 170px; max-height: 170px; margin-top: 8px; padding: 6px; background-color: rgb(14, 18, 24); border-radius: 6px; flex-shrink: 0; }
.edit-preview-image { height: 128px; min-height: 128px; flex-shrink: 0; }
.edit-preview-caption { font-size: 11px; color: rgb(151, 163, 181); height: 26px; min-height: 26px; max-height: 26px; white-space: normal; overflow: hidden; -unity-text-align: middle-center; }

.edit-rendered-preview { width: 280px; max-width: 100%; }

/* Compact concept-level navigation. Field-value changes retain these slots. */
.body { padding: 18px 22px 16px; }
.studio-title-row { min-height: 58px; margin-bottom: 6px; }
.studio-title-row > VisualElement { min-width: 0; flex-shrink: 1; }
.studio-title-row .title { font-size: 22px; margin-bottom: 4px; }
.studio-subtitle { font-size: 11px; margin-bottom: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.config-identity { flex-wrap: nowrap; margin: 0; min-height: 36px; }
.config-identity > #config-title { min-width: 0; max-width: none; flex-grow: 1; flex-shrink: 1; margin: 0 6px 0 0; }
.config-identity > #config-title > .unity-base-field__input { font-size: 20px; -unity-font-style: bold; height: 36px; min-height: 36px; background-color: rgba(0,0,0,0); border-color: rgba(0,0,0,0); padding: 2px 0; }
.config-identity > #config-title > .unity-base-field__input:focus { border-color: rgb(73,133,142); }
.experiment-actions { min-height: 34px; margin-bottom: 6px; flex-wrap: wrap; }
.experiment-actions Button { margin: 0 8px 0 0; }
.settings-tabs { margin: 0 0 10px; padding-bottom: 8px; flex-wrap: nowrap; }
.settings-tabs > .studio-button { flex-direction: row; width: 118px; height: 40px; min-height: 40px; margin: 0 6px 0 0; padding: 6px 10px; }
.settings-tabs > .studio-button > .studio-icon { width: 18px; height: 18px; margin: 0 8px 0 0; }
.settings-tabs > .studio-button > Label { font-size: 12px; }
.editor-shortcuts { margin-top: 6px; flex-wrap: wrap; }
.editor-shortcuts Button { margin-left: 0; margin-right: 8px; }
.editor-disclosure { margin: 6px 0 12px; padding-top: 4px; border-top-width: 1px; border-top-color: rgb(50,63,74); }
.editor-disclosure > .unity-foldout__toggle { height: 34px; min-height: 34px; color: rgb(201,218,230); font-size: 13px; }
.editor-disclosure > .unity-foldout__content { margin-left: 0; padding-top: 8px; }
.inherited-indicator { display: none; }
.quiet-hint { color: rgb(163,183,199); font-size: 12px; margin: 6px 0 12px; }
.workbench .spin-arrows > Button.studio-button { height: 14px; min-height: 14px; max-height: 14px; width: 18px; min-width: 18px; margin: 0; padding: 0; flex-shrink: 0; }
.workbench .spin-arrows { width: 18px; height: 28px; min-height: 28px; max-height: 28px; }
/* Object choices, surface color and a single thumbnail form one visual unit. */
.object-collection { margin-bottom: 12px; }
.object-collection > .section-heading > Label { flex-grow: 1; }
.scene-object-card { padding: 12px; margin-bottom: 12px; border-width: 1px; border-color: rgb(61,79,92); border-radius: 6px; background-color: rgb(23,31,40); }
.object-heading { margin-bottom: 8px; }
.object-heading .object-name { flex-grow: 1; color: rgb(215,229,239); -unity-font-style: bold; }
.object-heading > .studio-switch { margin-right: 12px; }
.object-visual-row { align-items: flex-start; flex-wrap: wrap; }
.object-main-controls { flex-grow: 1; flex-basis: 390px; min-width: 300px; margin-right: 14px; }
.object-main-controls > .studio-setting { width: 100%; max-width: 100%; min-width: 0; margin-right: 0; }
.object-main-controls > .path-setting { flex-direction: column; align-items: stretch; }
.object-main-controls > .path-setting > .setting-label { flex-basis: auto; margin: 0 0 5px; }
.external-model-control { width: 100%; }
.external-model-control > DropdownField, .external-model-control > TextField { width: 100%; min-width: 0; margin: 0 0 4px; }
.object-preview-slot { width: 344px; min-width: 0; max-width: 100%; flex-shrink: 0; }
.object-preview-slot .edit-rendered-preview { width: 100%; height: 248px; min-height: 248px; max-height: 248px; margin-top: 0; }
.object-preview-slot .edit-sky-preview { height: 192px; min-height: 192px; max-height: 192px; }
.object-preview-slot .edit-preview-image { flex-grow: 1; flex-shrink: 1; height: auto; min-height: 0; }
.compact-layout .object-preview-slot { width: 264px; }
.compact-layout .object-preview-slot .edit-rendered-preview { height: 170px; min-height: 170px; max-height: 170px; }
.narrow-layout .object-visual-row { flex-direction: column; flex-wrap: nowrap; align-items: stretch; }
.narrow-layout .object-main-controls { flex-grow: 0; flex-basis: auto; min-width: 0; margin-right: 0; }
.narrow-layout .object-preview-slot { align-self: flex-start; margin-top: 8px; }
.object-main-controls .asset-picker-control { max-width: 420px; }
.object-main-controls .external-model-control { max-width: 680px; }
.sky-main-controls > DropdownField { max-width: 420px; }
.object-color-row { min-height: 42px; justify-content: space-between; padding: 4px 10px; background-color: rgb(27,37,47); border-radius: 4px; }
.object-color-row .color-control { flex-shrink: 0; }
.surface-details { margin: 8px 0 0; }
.surface-details > .unity-foldout__toggle { font-size: 12px; min-height: 28px; }
.scene-object-card .vector-setting { max-width: 100%; }
.daily-welcome .start-title { font-size: 24px; margin-bottom: 4px; }
.daily-apparatus-summary { padding: 4px 0; }
.recording-summary-state { font-size: 12px; }

.asset-picker-control { min-height: 34px; height: 34px; flex-wrap: nowrap; }
.asset-picker-control > DropdownField { flex-grow: 1; flex-shrink: 1; width: auto; margin: 0; }
.asset-picker-control > Button { flex-shrink: 0; }
.external-model-control { flex-direction: row; align-items: center; height: 34px; min-height: 34px; }
.external-model-control > TextField { flex-grow: 1; flex-shrink: 1; width: auto; margin: 0 4px 0 0; }
.external-model-control > .model-file-menu { width: 34px; min-width: 34px; max-width: 34px; height: 32px; margin: 0; flex-shrink: 0; }
.model-file-menu .unity-base-popup-field__text { display: none; }
.object-main-controls > .choice-setting, .object-main-controls > .path-setting { flex-direction: column; align-items: stretch; min-height: 76px; padding: 8px 10px; }
.object-main-controls > .choice-setting > .setting-label, .object-main-controls > .path-setting > .setting-label { flex-grow: 0; flex-basis: auto; margin: 0 0 4px; }
.object-main-controls > .choice-setting .asset-picker-control, .object-main-controls > .path-setting .external-model-control { width: 100%; }

.workbench Button.runtime-color-swatch { width: 52px; min-width: 52px; height: 32px; min-height: 32px; margin: 0; padding: 5px; }
.runtime-color-swatch > .studio-icon { margin: 0; width: 18px; height: 18px; }

.studio-setting.surface-setting { width: 100%; max-width: 100%; flex-direction: column; align-items: stretch; }
.surface-setting > .surface-details > .unity-foldout__toggle { display: flex; }


/* Swarm groups retain compact controls while the cards use available columns. */
.studio-setting.swarm-group-setting { width: 100%; max-width: 100%; margin-right: 0; }
.swarm-group-toolbar { flex-wrap: wrap; margin-bottom: 6px; }
.swarm-group-toolbar > .quiet-hint { margin: 0 8px; }
.swarm-group-grid { flex-wrap: wrap; align-items: stretch; }
.swarm-group-card { width: 420px; max-width: 100%; padding: 10px 12px; margin: 0 8px 8px 0; border-width: 1px; border-radius: 5px; border-color: rgb(55, 75, 91); background-color: rgb(23, 31, 40); }
.swarm-group-header { margin-bottom: 6px; }
.swarm-group-header > Label { flex-grow: 1; color: rgb(215, 229, 239); -unity-font-style: bold; }
.swarm-group-header > Button { flex-shrink: 0; }
.swarm-group-values { flex-wrap: wrap; align-items: flex-start; }
.swarm-group-field { flex-shrink: 0; margin: 0 12px 6px 0; }
.swarm-group-field > DropdownField { width: 152px; margin-left: 0; }
.swarm-group-label { color: rgb(180, 198, 212); font-size: 12px; margin-bottom: 4px; }
#show-appearance-previews { margin-left: 8px; }


/* Names remain short while image paths can use the rest of the dialog row. */
.texture-variant-picker { flex-wrap: wrap; margin-bottom: 7px; }
.texture-variant-picker > DropdownField { width: 335px; max-width: 100%; margin-left: 0; }
.texture-variant-picker .unity-base-field__label { min-width: 0; width: 104px; }
.texture-variant-list { flex-grow: 1; min-height: 0; }
.texture-variant-entry { flex-wrap: wrap; padding: 7px 8px; margin-bottom: 7px; background-color: rgb(23, 31, 40); border-radius: 4px; }
.texture-variant-entry > .texture-variant-name, .texture-variant-entry > .texture-variant-path { flex-direction: column; align-items: stretch; margin-right: 8px; }
.texture-variant-entry .unity-base-field__label { min-width: 0; width: auto; margin-bottom: 4px; }
.texture-variant-name { width: 184px; max-width: 100%; }
.texture-variant-path { flex-grow: 1; flex-basis: 300px; min-width: 175px; }
.texture-variant-format { width: 76px; margin: 19px 4px 0; }
.texture-variant-entry > Button { margin-top: 19px; flex-shrink: 0; }
.texture-variant-actions { flex-wrap: wrap; margin-top: 10px; }
