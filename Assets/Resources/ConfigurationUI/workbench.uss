.workbench { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(16, 21, 31); color: rgb(219, 225, 238); font-size: 14px; }
.header { height: 76px; padding-left: 28px; padding-right: 28px; flex-direction: row; align-items: center; justify-content: space-between; background-color: rgb(22, 29, 43); border-bottom-width: 1px; border-bottom-color: rgb(47, 58, 78); }
.brand { font-size: 17px; -unity-font-style: bold; letter-spacing: 2px; }
.badge { color: rgb(92, 218, 187); font-size: 12px; padding: 9px 13px; background-color: rgb(28, 54, 52); border-radius: 5px; }
.main { flex-grow: 1; flex-direction: row; }
.sidebar { width: 254px; padding: 22px 16px; background-color: rgb(19, 26, 38); border-right-width: 1px; border-right-color: rgb(47, 58, 78); }
.sidebar Label { white-space: normal; color: rgb(143, 159, 184); margin-top: 16px; margin-bottom: 10px; font-size: 11px; }
.sidebar Button { height: auto; min-height: 39px; white-space: normal; -unity-text-align: middle-left; margin-bottom: 6px; }
.sidebar .unity-base-field { flex-direction: column; align-items: stretch; }
.sidebar .unity-base-field__label { min-width: 0; margin-bottom: 7px; }
.body { flex-grow: 1; flex-basis: 0; padding: 25px 24px 14px; }
.title { font-size: 27px; -unity-font-style: bold; margin-bottom: 8px; }
.location { font-size: 11px; color: rgb(143, 159, 184); margin-bottom: 18px; white-space: normal; }
.row { flex-direction: row; align-items: center; min-height: 40px; }
.breadcrumb { color: rgb(92, 218, 187); font-size: 12px; margin: 18px 0 8px; }
.search { flex-grow: 1; min-width: 80px; }
.body > .row > Toggle { min-width: 105px; }
.body > .row > Toggle > .unity-base-field__label { min-width: 0; }
.fields { flex-grow: 1; margin-top: 14px; margin-bottom: 12px; background-color: rgb(20, 28, 41); border-radius: 6px; }
.field-row { height: 64px; flex-direction: row; align-items: center; padding: 7px 12px; border-bottom-width: 1px; border-bottom-color: rgb(38, 49, 67); }
.caption { width: 43%; }
.caption > Label { white-space: normal; }
.key-hint { font-size: 10px; color: rgb(137, 154, 180); margin-top: 4px; }
.field-controls { flex-grow: 1; flex-basis: 0; flex-direction: row; align-items: center; }
.field-controls TextField, .field-controls DropdownField { flex-grow: 1; flex-basis: 0; min-width: 45px; }
.field-controls Button { flex-shrink: 0; }
.inspector { width: 272px; background-color: rgb(19, 26, 38); padding: 20px; border-left-width: 1px; border-left-color: rgb(47, 58, 78); }
.inspector Label { white-space: normal; font-size: 12px; color: rgb(164, 178, 201); margin-bottom: 18px; }
.footer { height: 76px; padding: 12px 24px; flex-direction: row; align-items: center; border-top-width: 1px; border-top-color: rgb(47, 58, 78); background-color: rgb(22, 29, 43); }
.status { flex-grow: 1; white-space: normal; font-size: 12px; color: rgb(143, 159, 184); }
.error { color: rgb(247, 151, 132); }
Button { background-color: rgb(34, 46, 64); color: rgb(219, 225, 238); border-width: 1px; border-color: rgb(58, 75, 100); border-radius: 5px; padding: 8px 12px; margin: 3px; height: 35px; }
Button:hover { background-color: rgb(48, 64, 87); border-color: rgb(92, 218, 187); }
Button.primary { background-color: rgb(81, 211, 180); color: rgb(12, 30, 32); -unity-font-style: bold; border-width: 0; min-width: 190px; }
Button.mini { padding: 3px 6px; height: 29px; font-size: 11px; }
Button.quiet { background-color: rgb(24, 34, 49); }
.unity-base-field { color: rgb(219, 225, 238); margin: 4px; }
.unity-base-field__input { background-color: rgb(13, 20, 31); color: rgb(226, 233, 245); border-color: rgb(57, 75, 99); border-radius: 4px; min-height: 27px; padding: 4px 7px; }
.unity-base-field__label { color: rgb(164, 178, 201); }
.unity-base-popup-field__text { color: rgb(226, 233, 245); }
.unity-toggle__checkmark { background-color: rgb(35, 49, 65); }
:disabled { opacity: 0.42; }
.raw-json { flex-grow: 1; margin-top: 16px; white-space: normal; }
.raw-json .unity-text-field__input { -unity-text-align: upper-left; white-space: normal; }
.metadata { flex-grow: 1; padding-top: 15px; }
.metadata Label { margin-top: 18px; margin-bottom: 5px; }
