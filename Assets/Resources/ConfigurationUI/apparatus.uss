/* Apparatus configuration and the compact daily experiment workspace. */
.apparatus-scroll { flex-grow: 1; min-height: 0; }
.apparatus-copy { color: rgb(182, 199, 213); font-size: 12px; white-space: normal; margin: 4px 0 10px; }
.apparatus-note { color: rgb(181, 197, 210); font-size: 12px; white-space: normal; margin: 8px 0; }
.apparatus-eyebrow { color: rgb(178, 199, 212); font-size: 11px; letter-spacing: 0; margin: 0 0 8px; }
.apparatus-intro { max-width: 900px; padding: 20px; background-color: rgb(27, 27, 27); border-width: 1px; border-color: rgb(61, 68, 73); border-radius: 6px; }
.apparatus-intro .session-section-heading { margin-top: 0; }
.apparatus-type-choices { flex-wrap: wrap; margin: 12px 0; }
.apparatus-type-choices > Button { margin-left: 0; margin-right: 10px; }
.apparatus-overview-controls { max-width: 1000px; flex-wrap: wrap; align-items: flex-start; margin: 12px 0 6px; }
.apparatus-input { flex-grow: 1; flex-basis: 0; min-width: 150px; max-width: 300px; margin: 5px 12px 7px 0; flex-direction: column; align-items: stretch; }
.apparatus-input > .unity-base-field__label { min-width: 0; margin-bottom: 6px; font-size: 12px; color: rgb(183, 198, 211); white-space: normal; }
.apparatus-overview-controls > .unity-popup-field { flex-grow: 1; flex-basis: 0; min-width: 180px; max-width: 300px; flex-direction: column; margin: 5px 0 7px; }
.apparatus-overview-controls > .unity-popup-field > .unity-base-field__label { min-width: 0; margin-bottom: 6px; font-size: 12px; color: rgb(183, 198, 211); }
.apparatus-native-option { align-items: center; max-width: 1000px; margin: 3px 0 16px; }
.apparatus-native-option .apparatus-copy { margin-bottom: 0; margin-left: 8px; }
.apparatus-map-section { max-width: 600px; padding: 16px; border-width: 1px; border-color: rgb(61, 68, 73); background-color: rgb(27, 27, 27); border-radius: 5px; margin-bottom: 18px; }
.apparatus-map-section .session-section-heading { margin-top: 0; margin-bottom: 8px; }
.apparatus-map-label { color: rgb(181, 199, 213); font-size: 12px; margin: 12px 0 7px; }
.apparatus-display-map { height: 210px; min-height: 0; max-width: 100%; padding: 0; border-width: 0; flex-shrink: 0; position: relative; background-color: rgb(12, 18, 24); overflow: hidden; }
.apparatus-pixel-cell { position: absolute; background-color: rgb(49, 91, 92); border-width: 1px; border-color: rgb(47, 73, 69); color: rgb(233, 244, 244); font-size: 11px; -unity-text-align: middle-center; overflow: hidden; }
.apparatus-map-legend { color: rgb(177, 198, 213); font-size: 11px; white-space: normal; margin-top: 6px; }
.apparatus-rig { max-width: 1120px; border-width: 1px; border-color: rgb(62, 68, 73); border-radius: 5px; background-color: rgb(27, 27, 27); margin: 0 0 12px; padding: 10px 14px; }
.apparatus-rig > .unity-foldout__toggle { font-size: 13px; color: rgb(180, 204, 218); margin: 2px 0; }
.apparatus-rig > .unity-foldout__content { margin-left: 0; padding-top: 10px; }
.apparatus-grid { align-items: flex-start; flex-wrap: wrap; }
.apparatus-grid > .apparatus-input { min-width: 160px; }
.apparatus-presets { flex-wrap: wrap; flex-grow: 1; margin-top: 22px; }
.apparatus-presets Button { margin-left: 0; }
.apparatus-order-row { flex-wrap: wrap; align-items: flex-end; margin-bottom: 10px; }
.apparatus-order-row > .apparatus-input { flex-grow: 0; flex-basis: 240px; }
.apparatus-order-row Button { margin-bottom: 7px; }
.apparatus-face-previews { flex-wrap: wrap; align-items: flex-start; margin: 5px 0 15px; }
.apparatus-face-net { margin-right: 24px; flex-shrink: 0; }
.apparatus-net-row { min-height: 0; }
.apparatus-net-blank, Button.apparatus-face { width: 64px; min-width: 64px; height: 64px; flex-shrink: 0; margin: 2px; }
Button.apparatus-face { flex-direction: column; padding: 4px; background-color: rgb(25, 27, 29); border-color: rgb(59, 69, 76); }
Button.apparatus-face > Label { flex-grow: 0; font-size: 18px; color: rgb(178, 198, 212); }
Button.apparatus-face.is-enabled { background-color: rgb(22, 29, 25); border-color: rgb(39, 76, 63); }
Button.apparatus-face.is-enabled > Label { color: rgb(155, 209, 193); }
Button.apparatus-face > .apparatus-face-name { font-size: 11px; color: rgb(175, 200, 215); }
Button.apparatus-face > .apparatus-face-slot { font-size: 9px; color: rgb(179, 197, 210); }
.apparatus-strip-preview { flex-grow: 1; min-width: 220px; max-width: 400px; margin-top: 4px; }
.apparatus-strip-tiles { flex-wrap: wrap; }
.apparatus-strip-tile { width: 48px; height: 48px; align-items: center; justify-content: center; border-width: 1px; border-color: rgb(52, 71, 73); border-radius: 3px; margin: 2px; background-color: rgb(23, 28, 28); }
.apparatus-strip-tile > Label { font-size: 17px; color: rgb(164, 205, 211); }
.apparatus-strip-tile > .apparatus-face-slot { font-size: 9px; color: rgb(177, 197, 212); }
.apparatus-advanced { margin: 12px 0; padding: 8px 0; border-top-width: 1px; border-top-color: rgb(62, 68, 72); }
.apparatus-advanced > .unity-foldout__toggle { align-self: flex-start; color: rgb(178, 199, 214); font-size: 12px; }
.apparatus-validation { white-space: normal; color: rgb(229, 191, 151); font-size: 12px; margin: 6px 0 12px; }
#apparatus-complete { align-self: flex-start; min-width: 200px; margin-left: 0; margin-top: 12px; }
.demo-worlds { max-width: 830px; margin-bottom: 12px; }
.demo-worlds .world-previews { flex-grow: 1; }
.demo-configure { max-width: 1120px; padding: 12px 0; border-bottom-width: 1px; border-bottom-color: rgb(63, 68, 72); margin-bottom: 18px; }
.demo-configure .apparatus-copy { margin-bottom: 0; }
.daily-welcome { margin-bottom: 10px; }
.daily-welcome .start-title { font-size: 28px; margin-bottom: 4px; }
.daily-welcome .start-subtitle { margin-top: 4px; margin-bottom: 4px; }
.daily-apparatus-summary { padding: 8px 0; }
.daily-apparatus-summary .apparatus-copy { margin-bottom: 0; }
.session-native-row { flex-wrap: wrap; }
.session-native-row .apparatus-copy { font-size: 12px; }
.session-native-row Button { height: 28px; }
.compact .apparatus-grid > .apparatus-input { min-width: 135px; }
.compact .apparatus-face-previews { flex-direction: column; }
.compact .apparatus-strip-preview { margin-top: 18px; }

#demo-options { max-width: 1120px; margin-top: 14px; }
#demo-options > .unity-foldout__toggle { min-height: 32px; padding: 4px 0; font-size: 13px; }
#demo-options > .unity-foldout__content { margin-left: 0; padding-top: 12px; }
.apparatus-rig > .unity-foldout__toggle { padding: 6px 0; -unity-font-style: bold; min-height: 32px; }
