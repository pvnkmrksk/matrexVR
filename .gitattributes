# Preserve Unity-generated importer metadata and verbatim upstream notices.
Assets/Resources/ConfigurationUI/Icons/*.meta -whitespace
Assets/Plugins/NaCl.dll.meta -whitespace
Assets/ThirdParty/TrackerTransport/** -whitespace
# Unified diffs require a single-space prefix on empty context lines. Keep the
# reviewed patch's exact LF bytes so its locked digest is portable.
tools/native_patches/*.patch text eol=lf whitespace=-blank-at-eol
