+#[test]
+fn additive_source_provenance_keeps_all_legacy_numerical_fields_unchanged() {
+    let runtime = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .unwrap();
+    runtime.block_on(async {
+        for (kind, expected) in [
+            (SourceKind::Camera, "camera"),
+            (SourceKind::Video, "video"),
+            (SourceKind::Demo, "demo"),
+            (SourceKind::Network, "network"),
+        ] {
+            let (mut publisher, port) = publisher();
+            publisher.set_source_provenance(kind, false);
+            let mut subscriber = zeromq::SubSocket::new();
+            subscriber
+                .connect(&format!("tcp://127.0.0.1:{port}"))
+                .await
+                .unwrap();
+            subscriber.subscribe("").await.unwrap();
+            let config = Config::demo();
+            let frame = GrayFrame::new(640, 480, vec![0; 640 * 480], 123_000_000_000, 17).unwrap();
+            let measurement = Tracker::new(&config, 640, 480)
+                .process(&frame, None, 0)
+                .unwrap();
+            let legacy = KineflyMessage::from(&measurement);
+            let mut received = None;
+            for _ in 0..20 {
+                publisher.send(&measurement).unwrap();
+                if let Ok(Ok(message)) =
+                    tokio::time::timeout(Duration::from_millis(100), subscriber.recv()).await
+                {
+                    received = Some(message);
+                    break;
+                }
+            }
+            let message = received.expect("source-annotated packet");
+            assert_eq!(message.len(), 1);
+            let bytes = message.get(0).unwrap();
+            assert_eq!(
+                serde_json::from_slice::<KineflyMessage>(bytes).unwrap(),
+                legacy
+            );
+            let metadata: serde_json::Value = serde_json::from_slice(bytes).unwrap();
+            assert_eq!(metadata["source_kind"], expected);
+            assert_eq!(metadata["source_fallback"], false);
+            assert_eq!(metadata.as_object().unwrap().len(), 10);
+            publisher.finish().unwrap();
+        }
+    });
 }
 
