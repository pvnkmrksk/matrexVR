+    pub fn attempt_formats<T>(
+        formats: impl IntoIterator<Item = CameraFormat>,
+        mut attempt: impl FnMut(CameraFormat) -> Result<T>,
+    ) -> Result<T> {
+        let mut errors = Vec::new();
+        for format in formats {
+            match attempt(format) {
+                Ok(opened) => return Ok(opened),
+                Err(error) => errors.push(format!("{format}: {error:#}")),
