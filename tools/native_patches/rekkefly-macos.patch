+fn camera_fallback_is_preview_only_and_closes_all_outputs() {
+    let dir = tempfile::tempdir().unwrap();
+    let receiver = std::net::UdpSocket::bind("127.0.0.1:0").unwrap();
+    receiver
+        .set_read_timeout(Some(Duration::from_millis(100)))
+        .unwrap();
+    let port = std::net::TcpListener::bind("127.0.0.1:0")
+        .unwrap()
+        .local_addr()
+        .unwrap()
+        .port();
+    let mut config = Config::default();
+    config.source = camera_source(&config, "/nonexistent/rekkefly-test-camera");
+    config.output.enabled = true;
+    config.output.bind = std::net::UdpSocket::bind("127.0.0.1:0")
+        .unwrap()
+        .local_addr()
+        .unwrap()
+        .to_string();
+    config.output.target = receiver.local_addr().unwrap().to_string();
+    config.output.zmq_enabled = true;
+    config.output.zmq_bind = format!("tcp://127.0.0.1:{port}");
+    let jsonl = dir.path().join("measurements.jsonl");
+    config.output.jsonl_path = jsonl.to_string_lossy().into_owned();
+    let engine = Engine::start_with(
+        config,
+        dir.path().join("rig.toml"),
+        StartOptions {
+            fallback: true,
+            ..Default::default()
+        },
+    )
+    .unwrap();
+    let state = wait(&engine, |s| s.frames >= 3);
+    assert!(state.error.is_none(), "{:?}", state.error);
+    assert!(state.fallback.is_some());
+    assert!(state.frames >= 3, "fallback preview should still advance");
+    // The preview must not produce UDP, JSONL or a still-listening ZMQ endpoint.
+    assert!(receiver.recv(&mut [0u8; 1024]).is_err());
+    assert_eq!(std::fs::read(&jsonl).unwrap(), Vec::<u8>::new());
+    let released = std::net::TcpListener::bind(("127.0.0.1", port))
+        .expect("camera fallback must close its ZMQ publisher");
+    drop(released);
+    engine.wait();
+}
